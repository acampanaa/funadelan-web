---
// Muestra texto enriquecido proveniente de Sanity (paginaEstatica.cuerpo).
// Si Sanity no tiene contenido, cae al respaldo estático pasado en el <slot>.
import { PortableText } from 'astro-portabletext';

interface Props {
  cuerpo?: any[];
}
const { cuerpo } = Astro.props;
const tieneCuerpo = Array.isArray(cuerpo) && cuerpo.length > 0;
---

{
  tieneCuerpo ? (
    <div class="richtext max-w-3xl">
      <PortableText value={cuerpo} />
    </div>
  ) : (
    <slot />
  )
}

<style>
  .richtext :global(p) {
    margin-bottom: 1.25rem;
  }
  .richtext :global(h2) {
    font-size: 1.75rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .richtext :global(h3) {
    font-size: 1.35rem;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .richtext :global(ul) {
    list-style: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .richtext :global(li) {
    margin-bottom: 0.4rem;
  }
  .richtext :global(a) {
    color: var(--color-celeste-600);
    text-decoration: underline;
  }
  .richtext :global(strong) {
    font-weight: 600;
  }
</style>
