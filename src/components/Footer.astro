---
import { mainNav } from '@/config/navigation';
import SuscripcionForm from '@/components/SuscripcionForm.astro';
import Logo from '@/components/Logo.astro';

const year = new Date().getFullYear();
const columns = mainNav.filter((item) => item.children);
---

<footer class="relative mt-24 overflow-hidden bg-celeste-800 text-celeste-100">
  <div class="cielo-estrellado pointer-events-none absolute inset-0 opacity-40" aria-hidden="true"></div>
  <div class="halo-dorado pointer-events-none absolute -top-24 right-0 h-72 w-72" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-6xl px-4 py-14">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-5">
      <div class="lg:col-span-1">
        <Logo tone="onDark" />
        <p class="mt-4 text-base leading-relaxed text-celeste-200">
          Fundación Amigos de los Ángeles. Promovemos la fe en los Ángeles y la
          ayuda social a personas mayores en Portoviejo, Manabí, Ecuador.
        </p>
      </div>

      {
        columns.map((col) => (
          <nav aria-label={col.label}>
            <h2 class="font-display text-lg font-semibold text-dorado-200">{col.label}</h2>
            <ul class="mt-3 space-y-2">
              {col.children!.map((child) => (
                <li>
                  <a href={child.href} class="text-base text-celeste-200 transition hover:text-white">
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <SuscripcionForm />
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-4 border-t border-celeste-700 pt-6 text-sm text-celeste-300 sm:flex-row sm:items-center">
      <p>© {year} FUNADELÁN — Fundación Amigos de los Ángeles. Todos los derechos reservados.</p>
      <p>Portoviejo, Manabí, Ecuador</p>
    </div>
  </div>
</footer>
