---
import { mainNav } from '@/config/navigation';
import Logo from '@/components/Logo.astro';
import Icono from '@/components/Icono.astro';

const year = new Date().getFullYear();
const columns = mainNav.filter((item) => item.children);
---

<footer class="mt-24 border-t border-arena-200 bg-arena-50">
  <div class="mx-auto max-w-6xl px-4 py-16">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-5">
      <div class="lg:col-span-1">
        <Logo imgClass="h-14 w-auto" />
        <p class="mt-4 font-display text-lg italic text-celeste-700">«Vivir para servir»</p>
        <p class="mt-3 text-base leading-relaxed text-tinta/70">
          Fundación Amigos de los Ángeles. Promovemos la fe en los Ángeles y la
          ayuda social a personas mayores en Portoviejo, Manabí, Ecuador.
        </p>
      </div>

      {
        columns.map((col) => (
          <nav aria-label={col.label}>
            <h2 class="font-display text-lg font-semibold text-celeste-800">{col.label}</h2>
            <ul class="mt-4 space-y-3">
              {col.children!.map((child) => (
                <li>
                  <a href={child.href} class="text-base text-tinta/70 transition hover:text-celeste-700">
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div>
        <h2 class="font-display text-lg font-semibold text-celeste-800">Recibe noticias</h2>
        <p class="mt-3 text-base text-tinta/70">Actividades y mensajes de la fundación en tu correo.</p>
        <form id="form-suscripcion" class="mt-4 flex flex-col gap-2.5">
          <label for="susc-email" class="sr-only">Correo electrónico</label>
          <input
            id="susc-email"
            name="email"
            type="email"
            required
            placeholder="tucorreo@ejemplo.com"
            class="w-full rounded-full border border-arena-200 bg-white px-4 py-2.5 text-base text-tinta placeholder:text-tinta/50 focus:border-dorado-400"
          />
          <button
            type="submit"
            class="rounded-full bg-dorado-400 px-5 py-2.5 text-base font-semibold text-celeste-900 transition hover:bg-dorado-300 disabled:opacity-60"
          >
            Suscribirme
          </button>
        </form>
        <p id="susc-mensaje" role="status" aria-live="polite" class="mt-2 text-sm"></p>
      </div>
    </div>
  </div>

  <!-- Barra de contacto: acento cálido con el motivo de cielo estrellado -->
  <div class="relative overflow-hidden bg-celeste-800 text-celeste-100">
    <div class="cielo-estrellado pointer-events-none absolute inset-0 opacity-40" aria-hidden="true"></div>
    <div class="halo-dorado pointer-events-none absolute -top-16 right-10 h-56 w-56" aria-hidden="true"></div>
    <div class="relative mx-auto flex max-w-6xl flex-col items-start justify-between gap-6 px-4 py-8 sm:flex-row sm:items-center">
      <p class="font-display text-xl">¿Necesitas ayuda o quieres colaborar?</p>
      <a
        href="/colabora/contacto"
        class="inline-flex items-center gap-2 rounded-full bg-dorado-400 px-6 py-3 text-base font-semibold text-celeste-900 transition hover:bg-dorado-300"
      >
        <Icono name="correo" class="h-5 w-5" />
        Contáctanos
      </a>
    </div>
    <div class="relative mx-auto flex max-w-6xl flex-col items-start justify-between gap-3 border-t border-celeste-700 px-4 py-5 text-sm text-celeste-300 sm:flex-row sm:items-center">
      <p>© {year} FUNADELÁN — Fundación Amigos de los Ángeles. Todos los derechos reservados.</p>
      <p>Portoviejo, Manabí, Ecuador</p>
    </div>
  </div>
</footer>

<script>
  const form = document.getElementById('form-suscripcion') as HTMLFormElement | null;
  const msg = document.getElementById('susc-mensaje');
  const boton = form?.querySelector('button');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!msg || !boton) return;

    const email = (form.elements.namedItem('email') as HTMLInputElement).value;
    boton.setAttribute('disabled', 'true');
    msg.textContent = 'Enviando…';
    msg.style.color = '#7a3b20';

    try {
      const res = await fetch('/api/suscribir', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const data = await res.json();
      if (data.ok) {
        msg.textContent = data.mensaje || '¡Listo! Revisa tu correo.';
        msg.style.color = '#166534';
        form.reset();
      } else {
        msg.textContent = data.error || 'Ocurrió un error. Intenta de nuevo.';
        msg.style.color = '#b91c1c';
      }
    } catch {
      msg.textContent = 'No se pudo conectar. Intenta más tarde.';
      msg.style.color = '#b91c1c';
    } finally {
      boton.removeAttribute('disabled');
    }
  });
</script>
