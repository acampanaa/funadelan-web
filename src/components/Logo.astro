---
// Logo oficial de FUNADELÁN (Fundación Amigos de los Ángeles).
// PNG con fondo transparente y lockup completo (marca + nombre + lema),
// por eso no lleva un wordmark de texto aparte.
// El arte tiene texto oscuro (pensado para fondo claro): en fondos oscuros
// (tone="onDark") se coloca sobre una tarjeta cálida para mantener legibilidad.
interface Props {
  class?: string;
  imgClass?: string;
  tone?: 'onLight' | 'onDark';
  href?: string | null;
}

const {
  class: className = '',
  imgClass = 'h-14 w-auto',
  tone = 'onLight',
  href = '/',
} = Astro.props;

const Tag = href ? 'a' : 'div';
const alt = 'FUNADELÁN — Fundación Amigos de los Ángeles';
---

<Tag
  {...href ? { href, 'aria-label': `${alt} — Inicio` } : {}}
  class:list={['inline-flex items-center transition-opacity hover:opacity-90', className]}
>
  {
    tone === 'onDark' ? (
      <span class="inline-flex rounded-sm bg-crema p-2 ring-1 ring-white/15">
        <img src="/logo.png" alt={alt} class:list={[imgClass]} width="500" height="500" />
      </span>
    ) : (
      <img src="/logo.png" alt={alt} class:list={[imgClass]} width="500" height="500" />
    )
  }
</Tag>
