---
import { mainNav } from '@/config/navigation';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-celeste-100 bg-crema/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="flex items-center gap-3" aria-label="FUNADELÁN — Inicio">
      <span
        class="grid h-11 w-11 place-items-center rounded-full bg-celeste-700 text-2xl text-dorado-300"
        aria-hidden="true">✦</span>
      <span class="font-display text-2xl font-semibold tracking-tight text-celeste-800">
        FUNADELÁN
      </span>
    </a>

    <!-- Navegación de escritorio -->
    <nav class="hidden lg:block" aria-label="Navegación principal">
      <ul class="flex items-center gap-1">
        {
          mainNav.slice(1).map((item) => (
            <li class="group relative">
              <a
                href={item.href}
                class:list={[
                  'inline-flex items-center rounded-lg px-3 py-2 text-base font-medium transition-colors hover:bg-celeste-50 hover:text-celeste-700',
                  isActive(item.href) ? 'text-celeste-700' : 'text-tinta',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
              {item.children && (
                <ul class="invisible absolute left-0 top-full min-w-60 rounded-xl border border-celeste-100 bg-white p-2 opacity-0 shadow-lg transition group-hover:visible group-hover:opacity-100">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class="block rounded-lg px-3 py-2 text-base text-tinta hover:bg-celeste-50 hover:text-celeste-700"
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
        <li>
          <a
            href="/colabora/donar"
            class="ml-2 inline-flex items-center rounded-full bg-dorado-400 px-5 py-2.5 text-base font-semibold text-celeste-900 shadow-sm transition hover:bg-dorado-300"
          >
            Donar
          </a>
        </li>
      </ul>
    </nav>

    <!-- Botón móvil -->
    <button
      id="menu-toggle"
      class="inline-flex items-center gap-2 rounded-lg border border-celeste-200 px-3 py-2 text-base font-medium text-celeste-700 lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span aria-hidden="true">☰</span> Menú
    </button>
  </div>

  <!-- Navegación móvil -->
  <nav
    id="mobile-nav"
    class="hidden border-t border-celeste-100 bg-white px-4 py-3 lg:hidden"
    aria-label="Navegación principal (móvil)"
  >
    <ul class="space-y-1">
      {
        mainNav.slice(1).map((item) => (
          <li>
            <a href={item.href} class="block rounded-lg px-3 py-2.5 text-lg font-medium text-tinta hover:bg-celeste-50">
              {item.label}
            </a>
            {item.children && (
              <ul class="ml-3 border-l border-celeste-100 pl-3">
                {item.children.map((child) => (
                  <li>
                    <a href={child.href} class="block rounded-lg px-3 py-2 text-base text-tinta/80 hover:bg-celeste-50">
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
