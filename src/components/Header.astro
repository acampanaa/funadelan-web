---
import { mainNav } from '@/config/navigation';
import Logo from '@/components/Logo.astro';
import Icono from '@/components/Icono.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<div class="font-header hidden border-b border-celeste-800 bg-celeste-900 text-sm text-white/80 lg:block">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-2">
    <a href="/colabora/contacto" class="inline-flex items-center gap-2 hover:text-white">
      <Icono name="ubicacion" class="h-4 w-4 text-dorado-300" />
      Portoviejo, Manabí, Ecuador
    </a>
    <a href="mailto:fundacionamigosdelosangeles@gmail.com" class="inline-flex items-center gap-2 hover:text-white">
      <Icono name="correo" class="h-4 w-4 text-dorado-300" />
      fundacionamigosdelosangeles@gmail.com
    </a>
  </div>
</div>

<header class="font-header sticky top-0 z-50 border-b border-arena-200 bg-crema">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-5 px-4 py-3">
    <Logo imgClass="h-13 w-auto lg:h-15" />

    <div id="nav-cluster" class="flex flex-1 items-center justify-end gap-2">
      <nav class="hidden lg:block" aria-label="Navegación principal">
        <ul class="flex items-stretch">
          {
            mainNav.slice(1).map((item) => (
              <li class="group relative">
                <a
                  href={item.href}
                  class:list={[
                    'inline-flex h-12 items-center gap-1 border-b-2 px-3 text-base font-semibold transition-colors',
                    isActive(item.href)
                      ? 'border-celeste-700 text-celeste-700'
                      : 'border-transparent text-tinta/80 hover:border-arena-200 hover:text-celeste-700',
                  ]}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                  {item.children && <Icono name="chevron" class="h-4 w-4 text-tinta/45" />}
                </a>

                {item.children && (
                  <ul class="invisible absolute left-0 top-full min-w-64 border border-arena-200 bg-crema py-2 opacity-0 group-hover:visible group-hover:opacity-100">
                    {item.children.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          target={child.external ? '_blank' : undefined}
                          rel={child.external ? 'noopener noreferrer' : undefined}
                          class="block border-l-2 border-transparent px-4 py-2.5 text-base text-tinta/80 hover:border-celeste-700 hover:bg-arena-50 hover:text-celeste-700"
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
      </nav>

      <button
        id="search-toggle"
        class="inline-flex h-11 w-11 items-center justify-center border border-transparent text-tinta/70 hover:border-arena-200 hover:text-celeste-700"
        aria-label="Buscar"
        aria-expanded="false"
        aria-controls="search-inline"
      >
        <Icono name="lupa" class="h-5 w-5" />
      </button>

      <!-- Donaciones temporalmente deshabilitadas. Volver a activar cuando esté listo.
      <a
        href="/colabora/donar"
        class="hidden items-center gap-2 border border-dorado-500 bg-dorado-400 px-5 py-2.5 text-base font-semibold text-celeste-900 hover:bg-dorado-300 lg:inline-flex"
      >
        <Icono name="corazon" class="h-5 w-5" />
        Donar
      </a>
      -->

      <button
        id="menu-toggle"
        class="inline-flex min-h-11 items-center gap-2 border border-arena-200 px-3 py-2 text-base font-semibold text-celeste-700 hover:bg-arena-50 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <Icono name="menu" class="h-5 w-5" />
        Menú
      </button>
    </div>

    <form
      id="search-inline"
      action="/buscar"
      method="get"
      role="search"
      class="hidden flex flex-1 items-center gap-2"
    >
      <Icono name="lupa" class="h-5 w-5 shrink-0 text-celeste-700" />
      <label for="search-input" class="sr-only">Buscar en el sitio</label>
      <input
        id="search-input"
        type="search"
        name="q"
        placeholder="Buscar en FUNADELÁN…"
        autocomplete="off"
        class="min-w-0 flex-1 border border-arena-200 bg-white px-4 py-2.5 text-base text-tinta placeholder:text-tinta/70 focus:border-celeste-700"
      />
      <button type="submit" class="shrink-0 bg-celeste-700 px-5 py-2.5 text-base font-semibold text-white hover:bg-celeste-600">
        Buscar
      </button>
      <button
        type="button"
        id="search-close"
        class="inline-flex h-11 w-11 shrink-0 items-center justify-center text-tinta/70 hover:bg-arena-50"
        aria-label="Cerrar búsqueda"
      >
        <span aria-hidden="true" class="text-2xl leading-none">×</span>
      </button>
    </form>
  </div>

  <nav
    id="mobile-nav"
    class="absolute left-0 right-0 top-full hidden overflow-y-auto overscroll-contain border-t border-arena-200 bg-crema px-4 pb-5 pt-2 shadow-lg [scrollbar-gutter:stable] [touch-action:pan-y] lg:hidden"
    aria-label="Navegación principal móvil"
  >
    <ul class="divide-y divide-arena-200">
      {
        mainNav.slice(1).map((item, i) => (
          <li>
            {item.children ? (
              <>
                <button
                  type="button"
                  data-accordion={i}
                  class="flex w-full items-center justify-between py-3 text-left text-lg font-semibold text-tinta"
                  aria-expanded="false"
                >
                  <span>{item.label}</span>
                  <Icono name="chevron" class="h-5 w-5 text-tinta/50 transition-transform" />
                </button>
                <ul id={`mobile-sub-${i}`} class="hidden border-l border-arena-200 pb-3 pl-4">
                  <li>
                    <a href={item.href} class="block py-2 font-semibold text-celeste-700">
                      Ver todo: {item.label}
                    </a>
                  </li>
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        target={child.external ? '_blank' : undefined}
                        rel={child.external ? 'noopener noreferrer' : undefined}
                        class="block py-2 text-tinta/80 hover:text-celeste-700"
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            ) : (
              <a href={item.href} class="block py-3 text-lg font-semibold text-tinta hover:text-celeste-700">
                {item.label}
              </a>
            )}
          </li>
        ))
      }
      <!-- Donaciones temporalmente deshabilitadas. Volver a activar cuando esté listo.
      <li class="pt-4">
        <a href="/colabora/donar" class="inline-flex items-center gap-2 border border-dorado-500 bg-dorado-400 px-5 py-2.5 font-semibold text-celeste-900">
          <Icono name="corazon" class="h-5 w-5" />
          Donar
        </a>
      </li>
      -->
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('mobile-nav');

  const ajustarAlturaMenu = () => {
    if (!nav || nav.classList.contains('hidden')) return;
    const espacioDisponible = window.innerHeight - nav.getBoundingClientRect().top;
    nav.style.maxHeight = `${Math.max(160, espacioDisponible)}px`;
  };

  const mostrarMenu = (abrir: boolean) => {
    nav?.classList.toggle('hidden', !abrir);
    toggle?.setAttribute('aria-expanded', String(abrir));
    if (abrir) requestAnimationFrame(ajustarAlturaMenu);
    else if (nav) nav.style.maxHeight = '';
  };

  toggle?.addEventListener('click', () => {
    mostrarMenu(nav?.classList.contains('hidden') ?? true);
  });

  window.addEventListener('resize', ajustarAlturaMenu);

  const searchToggle = document.getElementById('search-toggle');
  const navCluster = document.getElementById('nav-cluster');
  const searchInline = document.getElementById('search-inline');
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const searchClose = document.getElementById('search-close');

  function abrirBusqueda(abrir: boolean) {
    if (abrir) mostrarMenu(false);
    navCluster?.classList.toggle('hidden', abrir);
    searchInline?.classList.toggle('hidden', !abrir);
    searchToggle?.setAttribute('aria-expanded', String(abrir));
    if (abrir) searchInput?.focus();
  }

  searchToggle?.addEventListener('click', () => abrirBusqueda(true));
  searchClose?.addEventListener('click', () => abrirBusqueda(false));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      abrirBusqueda(false);
      mostrarMenu(false);
      toggle?.focus();
    }
  });

  document.querySelectorAll<HTMLButtonElement>('[data-accordion]').forEach((button) => {
    const index = button.dataset.accordion;
    const submenu = document.getElementById(`mobile-sub-${index}`);
    const chevron = button.querySelector('svg');

    button.addEventListener('click', () => {
      const expanded = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!expanded));
      submenu?.classList.toggle('hidden', expanded);
      if (chevron) chevron.style.transform = expanded ? '' : 'rotate(180deg)';
      requestAnimationFrame(ajustarAlturaMenu);
    });
  });
</script>
