---
import { mainNav } from '@/config/navigation';
import Logo from '@/components/Logo.astro';
import Icono from '@/components/Icono.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-arena-200/70 bg-crema/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <Logo />

    <div id="nav-cluster" class="flex items-center gap-2">
    <!-- Botón de búsqueda (siempre visible) -->
    <button
      id="search-toggle"
      class="inline-flex h-11 w-11 items-center justify-center rounded-full text-celeste-700 transition hover:bg-celeste-50"
      aria-label="Buscar"
      aria-expanded="false"
      aria-controls="search-inline"
    >
      <Icono name="lupa" class="h-6 w-6" />
    </button>

    <!-- Navegación de escritorio -->
    <nav class="hidden lg:block" aria-label="Navegación principal">
      <ul class="flex items-center gap-1">
        {
          mainNav.slice(1).map((item) => (
            <li class="group relative">
              <a
                href={item.href}
                class:list={[
                  'inline-flex items-center rounded-lg px-3 py-2 text-base font-medium transition-colors hover:bg-celeste-50 hover:text-celeste-700',
                  isActive(item.href) ? 'text-celeste-700' : 'text-tinta',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
              {item.children && (
                <ul class="invisible absolute left-0 top-full min-w-60 rounded-xl border border-celeste-100 bg-white p-2 opacity-0 shadow-lg transition group-hover:visible group-hover:opacity-100">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class="block rounded-lg px-3 py-2 text-base text-tinta hover:bg-celeste-50 hover:text-celeste-700"
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
        <li>
          <a
            href="/colabora/donar"
            class="ml-2 inline-flex items-center gap-2 rounded-full bg-dorado-400 px-5 py-2.5 text-base font-semibold text-celeste-900 shadow-sm transition hover:bg-dorado-300 hover:shadow-md"
          >
            <Icono name="corazon" class="h-5 w-5" />
            Donar
          </a>
        </li>
      </ul>
    </nav>

    <!-- Botón móvil -->
    <button
      id="menu-toggle"
      class="inline-flex items-center gap-2 rounded-lg border border-celeste-200 px-3 py-2 text-base font-medium text-celeste-700 transition hover:bg-celeste-50 lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <Icono name="menu" class="h-5 w-5" /> Menú
    </button>
    </div>

    <!-- Barra de búsqueda en línea: reemplaza los botones al abrirse -->
    <form
      id="search-inline"
      action="/buscar"
      method="get"
      role="search"
      class="hidden flex flex-1 items-center gap-2"
    >
      <Icono name="lupa" class="h-6 w-6 shrink-0 text-celeste-600" />
      <label for="search-input" class="sr-only">Buscar en el sitio</label>
      <input
        id="search-input"
        type="search"
        name="q"
        placeholder="Buscar publicaciones, noticias, oraciones…"
        autocomplete="off"
        class="w-full rounded-full border border-arena-200 bg-white px-5 py-2.5 text-base text-tinta placeholder:text-tinta/50 focus:border-dorado-400"
      />
      <button
        type="submit"
        class="shrink-0 rounded-full bg-celeste-700 px-5 py-2.5 text-base font-semibold text-white transition hover:bg-celeste-600"
      >
        Buscar
      </button>
      <button
        type="button"
        id="search-close"
        class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-tinta/60 transition hover:bg-celeste-50"
        aria-label="Cerrar búsqueda"
      >
        <span aria-hidden="true" class="text-2xl leading-none">×</span>
      </button>
    </form>
  </div>

  <!-- Navegación móvil -->
  <nav
    id="mobile-nav"
    class="hidden border-t border-celeste-100 bg-white px-4 py-3 lg:hidden"
    aria-label="Navegación principal (móvil)"
  >
    <ul class="space-y-1">
      {
        mainNav.slice(1).map((item) => (
          <li>
            <a href={item.href} class="block rounded-lg px-3 py-2.5 text-lg font-medium text-tinta hover:bg-celeste-50">
              {item.label}
            </a>
            {item.children && (
              <ul class="ml-3 border-l border-celeste-100 pl-3">
                {item.children.map((child) => (
                  <li>
                    <a href={child.href} class="block rounded-lg px-3 py-2 text-base text-tinta/80 hover:bg-celeste-50">
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });

  // Búsqueda en línea: la barra reemplaza los botones del header y viceversa.
  const searchToggle = document.getElementById('search-toggle');
  const navCluster = document.getElementById('nav-cluster');
  const searchInline = document.getElementById('search-inline');
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const searchClose = document.getElementById('search-close');

  function abrirBusqueda(abrir: boolean) {
    navCluster?.classList.toggle('hidden', abrir);
    searchInline?.classList.toggle('hidden', !abrir);
    searchToggle?.setAttribute('aria-expanded', String(abrir));
    if (abrir) searchInput?.focus();
  }

  searchToggle?.addEventListener('click', () => abrirBusqueda(true));
  searchClose?.addEventListener('click', () => abrirBusqueda(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !searchInline?.classList.contains('hidden')) abrirBusqueda(false);
  });
</script>
