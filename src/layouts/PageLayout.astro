---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  lead?: string;
  breadcrumbs?: Crumb[];
}

const { title, description, lead, breadcrumbs = [] } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <section class="border-b border-arena-200 bg-arena-50">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:py-16">
      <Breadcrumbs items={[...breadcrumbs, { label: title }]} />
      <div class="mt-5 grid gap-5 border-t border-celeste-700 pt-5 lg:grid-cols-[minmax(0,2fr)_minmax(18rem,1fr)] lg:gap-16">
        <h1 class="font-display text-4xl font-semibold text-celeste-900 sm:text-5xl">{title}</h1>
        {lead && <p class="max-w-xl text-lg leading-relaxed text-tinta/75 lg:pt-1">{lead}</p>}
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 py-12 sm:py-16">
    <slot />
  </div>
</BaseLayout>
