---
import PageLayout from '@/layouts/PageLayout.astro';
import ContenidoEditable from '@/components/ContenidoEditable.astro';
import Icono from '@/components/Icono.astro';
import { getPaginaEstatica } from '@/lib/sanity';

const breadcrumbs = [{ label: 'Quiénes somos', href: '/quienes-somos' }];

const pagina = await getPaginaEstatica('mision-vision');
const lead = pagina?.lead || 'Hacia dónde vamos y por qué.';
---

<PageLayout title="Misión / Visión" lead={lead} breadcrumbs={breadcrumbs}>
  <ContenidoEditable cuerpo={pagina?.cuerpo}>
    <div class="max-w-3xl space-y-14">
      <div>
        <h2 class="flex items-center gap-3 font-display text-4xl font-bold sm:text-5xl">
          <Icono name="brujula" class="h-8 w-8 shrink-0 text-celeste-700" />
          Misión
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-tinta/85">
          Promover la fe en los Ángeles y su labor como mensajeros de Dios.
          Realizar ayuda social a todos quienes lo necesiten, siempre con
          autogestión en base a actividades y desprendimiento de socios, amigos
          y aliados.
        </p>
      </div>
      <div class="border-t border-arena-200 pt-14">
        <h2 class="flex items-center gap-3 font-display text-4xl font-bold sm:text-5xl">
          <Icono name="estrella" class="h-8 w-8 shrink-0 text-celeste-700" />
          Visión
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-tinta/85">
          Ser una entidad sustentable y sostenible en el tiempo, con sede y
          servicios permanentes. Ser un referente de fe, armonía y solidaridad
          para los más vulnerables.
        </p>
      </div>
      <img
        src="/img/quienes-somos/mision-vision.jpg"
        alt="Adultos mayores y voluntarios de FUNADELÁN reunidos junto a la estatua del Ángel en una celebración de la fundación"
        width="2000"
        height="1122"
        class="aspect-video w-full rounded-3xl object-cover shadow-[var(--shadow-suave)]"
        loading="eager"
      />
    </div>
  </ContenidoEditable>
</PageLayout>
