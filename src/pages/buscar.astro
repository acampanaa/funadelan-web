---
import PageLayout from '@/layouts/PageLayout.astro';
import Icono from '@/components/Icono.astro';
import { buscar, formatearFecha } from '@/lib/sanity';

// Se renderiza en el servidor para consultar Sanity en vivo con el término.
export const prerender = false;

const url = new URL(Astro.request.url);
const q = (url.searchParams.get('q') || '').trim();
const resultados = q ? ((await buscar(q)) as any[]) : [];

const rutaPorTipo: Record<string, (slug?: string) => string> = {
  post: (s) => `/posts/${s}`,
  noticia: (s) => `/noticias/${s}`,
  reflexion: (s) => `/espiritualidad/reflexiones/${s}`,
  oracion: () => `/oraciones`,
};
const etiquetaTipo: Record<string, string> = {
  post: 'Publicación',
  noticia: 'Noticia',
  reflexion: 'Reflexión',
  oracion: 'Oración',
};

const lead = q
  ? `${resultados.length} resultado${resultados.length === 1 ? '' : 's'} para «${q}»`
  : 'Escribe un término para buscar en el sitio.';
---

<PageLayout title="Búsqueda" lead={lead}>
  <div class="mx-auto max-w-3xl">
    <!-- Barra de búsqueda de la propia página -->
    <form action="/buscar" method="get" role="search" class="mb-10 flex items-center gap-2">
      <Icono name="lupa" class="h-6 w-6 shrink-0 text-celeste-600" />
      <label for="q" class="sr-only">Buscar</label>
      <input
        id="q"
        type="search"
        name="q"
        value={q}
        placeholder="Buscar publicaciones, noticias, oraciones…"
        autocomplete="off"
        class="w-full rounded-full border border-arena-200 bg-white px-5 py-3 text-base text-tinta placeholder:text-tinta/50 focus:border-dorado-400"
      />
      <button
        type="submit"
        class="shrink-0 rounded-full bg-celeste-700 px-6 py-3 text-base font-semibold text-white transition hover:bg-celeste-600"
      >
        Buscar
      </button>
    </form>

    {
      q && resultados.length === 0 ? (
        <div class="rounded-2xl border border-arena-200/70 bg-white p-10 text-center">
          <span class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-celeste-50 text-celeste-700">
            <Icono name="lupa" class="h-7 w-7" />
          </span>
          <p class="mt-4 text-lg text-tinta/80">
            No encontramos nada para «<strong>{q}</strong>».
          </p>
          <p class="mt-1 text-base text-tinta/70">Prueba con otras palabras.</p>
        </div>
      ) : (
        <ul class="divide-y divide-arena-200/70">
          {resultados.map((r) => {
            const href = (rutaPorTipo[r._type] || (() => '/'))(r.slug);
            return (
              <li>
                <a href={href} class="group flex flex-col gap-1 py-6">
                  <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-celeste-50 px-3 py-1 text-sm font-semibold text-celeste-700">
                    <Icono name="estrella" class="h-3.5 w-3.5" />
                    {etiquetaTipo[r._type] || 'Contenido'}
                    {r.fecha && <span class="text-tinta/50">· {formatearFecha(r.fecha)}</span>}
                  </span>
                  <h2 class="text-2xl text-celeste-800 transition group-hover:text-celeste-500 group-hover:underline underline-offset-4">{r.titulo}</h2>
                  {r.resumen && <p class="text-base text-tinta/75">{r.resumen}</p>}
                </a>
              </li>
            );
          })}
        </ul>
      )
    }
  </div>
</PageLayout>
