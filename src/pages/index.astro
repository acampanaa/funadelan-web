---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getUltimasNoticias, urlForImage, formatearFecha } from '@/lib/sanity';

const programas = [
  {
    titulo: 'Centro Diurno "Ángeluz"',
    descripcion:
      'Atención diurna integral para adultos mayores: salud, recreación, alimentación y compañía.',
    href: '/programas/actividades-sociales',
    emoji: '☀️',
  },
  {
    titulo: 'Universidad del Adulto Mayor',
    descripcion:
      'Formación, cultura y desarrollo personal para seguir aprendiendo a cualquier edad.',
    href: '/programas/universidad-adulto-mayor',
    emoji: '🎓',
  },
  {
    titulo: 'Red Mundial del Adulto Mayor',
    descripcion:
      'Una red de aliados y comunidades unidas por la dignidad de las personas mayores.',
    href: '/programas/red-mundial',
    emoji: '🌎',
  },
];

const cifras = [
  { valor: '+15', etiqueta: 'años de labor social' },
  { valor: '+200', etiqueta: 'adultos mayores acompañados' },
  { valor: '+30', etiqueta: 'voluntarios y aliados' },
  { valor: '1', etiqueta: 'misión: servir con amor' },
];

// Últimas 3 noticias desde Sanity. Si aún no hay contenido publicado,
// se muestran ejemplos para no dejar la sección vacía.
const noticiasSanity = await getUltimasNoticias(3);
const noticiasEjemplo = [
  { _id: 'ej-1', titulo: 'Próximamente: Chocolate para el Alma', resumen: 'Nuestro evento anual regresa el 15 de noviembre.', fechaLabel: '15 nov', href: '/noticias', imagen: null },
  { _id: 'ej-2', titulo: 'Novena de octubre', resumen: 'Acompáñanos en la novena hasta el 2 de octubre.', fechaLabel: '02 oct', href: '/noticias', imagen: null },
  { _id: 'ej-3', titulo: 'Bazar de los Ángeles', resumen: 'Un espacio de encuentro solidario para toda la comunidad.', fechaLabel: 'Pronto', href: '/noticias', imagen: null },
];

const noticias =
  Array.isArray(noticiasSanity) && noticiasSanity.length > 0
    ? noticiasSanity.map((n: any) => ({
        _id: n._id,
        titulo: n.titulo,
        resumen: n.resumen,
        fechaLabel: formatearFecha(n.fecha, { day: '2-digit', month: 'short' }),
        href: `/noticias/${n.slug}`,
        imagen: n.imagen,
      }))
    : noticiasEjemplo;
---

<BaseLayout>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-celeste-800 text-white">
    <div class="absolute inset-0 opacity-20" aria-hidden="true"
      style="background-image: radial-gradient(circle at 20% 20%, #e9bf5a 0, transparent 40%), radial-gradient(circle at 80% 0%, #4f86c9 0, transparent 45%);">
    </div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-4 py-20 lg:grid-cols-2 lg:py-28">
      <div class="animate-fade-up">
        <p class="mb-4 inline-block rounded-full bg-celeste-700/70 px-4 py-1.5 text-sm font-medium text-dorado-200">
          Fundación Amigos de los Ángeles
        </p>
        <h1 class="font-display text-4xl font-semibold leading-tight text-white sm:text-5xl lg:text-6xl">
          Mensajeros de fe,<br />manos que sirven
        </h1>
        <p class="mt-6 max-w-xl text-lg text-celeste-100">
          Promovemos la fe en los Ángeles y acompañamos con dignidad a las personas
          mayores de Portoviejo. Tu apoyo hace posible nuestra misión.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/colabora/donar"
            class="inline-flex items-center rounded-full bg-dorado-400 px-7 py-3.5 text-lg font-semibold text-celeste-900 shadow-md transition hover:bg-dorado-300">
            Quiero donar
          </a>
          <a href="/quienes-somos"
            class="inline-flex items-center rounded-full border border-celeste-300 px-7 py-3.5 text-lg font-semibold text-white transition hover:bg-celeste-700">
            Conócenos
          </a>
        </div>
      </div>
      <div class="hidden justify-center lg:flex" aria-hidden="true">
        <div class="grid h-72 w-72 place-items-center rounded-full bg-gradient-to-br from-dorado-300 to-celeste-500 text-[10rem] shadow-2xl">
          ✦
        </div>
      </div>
    </div>
  </section>

  <!-- CIFRAS DE IMPACTO -->
  <section class="border-b border-celeste-100 bg-white">
    <div class="mx-auto grid max-w-6xl grid-cols-2 gap-6 px-4 py-12 lg:grid-cols-4">
      {
        cifras.map((c) => (
          <div class="text-center">
            <p class="font-display text-4xl font-bold text-celeste-700 lg:text-5xl">{c.valor}</p>
            <p class="mt-2 text-base text-tinta/70">{c.etiqueta}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- PROGRAMAS -->
  <section class="mx-auto max-w-6xl px-4 py-20">
    <div class="mb-10 max-w-2xl">
      <h2 class="font-display text-3xl font-semibold sm:text-4xl">Nuestros programas</h2>
      <p class="mt-3 text-lg text-tinta/75">
        Iniciativas que transforman la vida de las personas mayores y fortalecen su comunidad.
      </p>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {
        programas.map((p) => (
          <a
            href={p.href}
            class="group flex flex-col rounded-2xl border border-celeste-100 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:border-celeste-200 hover:shadow-lg"
          >
            <span class="text-4xl" aria-hidden="true">{p.emoji}</span>
            <h3 class="mt-4 text-2xl">{p.titulo}</h3>
            <p class="mt-3 flex-1 text-base text-tinta/75">{p.descripcion}</p>
            <span class="mt-5 font-semibold text-celeste-600 transition group-hover:text-celeste-700">
              Ver más →
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ÚLTIMAS NOTICIAS -->
  <section class="bg-celeste-50/60">
    <div class="mx-auto max-w-6xl px-4 py-20">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="font-display text-3xl font-semibold sm:text-4xl">Últimas noticias</h2>
          <p class="mt-3 text-lg text-tinta/75">Lo más reciente de la fundación.</p>
        </div>
        <a href="/noticias"
          class="inline-flex items-center rounded-full border border-celeste-300 px-6 py-3 text-base font-semibold text-celeste-700 transition hover:bg-white">
          Ver todas
        </a>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {
          noticias.map((n) => (
            <a href={n.href} class="group flex flex-col overflow-hidden rounded-2xl bg-white shadow-sm transition hover:shadow-lg">
              {n.imagen ? (
                <img
                  src={urlForImage(n.imagen).width(800).height(440).fit('crop').url()}
                  alt={n.titulo}
                  class="h-44 w-full object-cover"
                  loading="lazy"
                />
              ) : (
                <div class="grid h-44 place-items-center bg-gradient-to-br from-celeste-100 to-dorado-100 text-5xl" aria-hidden="true">✦</div>
              )}
              <div class="flex flex-1 flex-col p-6">
                <span class="text-sm font-semibold uppercase tracking-wide text-dorado-600">{n.fechaLabel}</span>
                <h3 class="mt-2 text-xl">{n.titulo}</h3>
                <p class="mt-2 flex-1 text-base text-tinta/75">{n.resumen}</p>
                <span class="mt-4 font-semibold text-celeste-600 group-hover:text-celeste-700">Leer →</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="mx-auto max-w-6xl px-4 py-20">
    <div class="rounded-3xl bg-celeste-700 px-8 py-14 text-center text-white">
      <h2 class="font-display text-3xl font-semibold text-white sm:text-4xl">Sé parte de la misión</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-celeste-100">
        Como socio, voluntario o donante, tu apoyo sostiene el acompañamiento a quienes más lo necesitan.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/colabora/donar" class="rounded-full bg-dorado-400 px-7 py-3.5 text-lg font-semibold text-celeste-900 transition hover:bg-dorado-300">Donar ahora</a>
        <a href="/colabora/voluntariado" class="rounded-full border border-celeste-300 px-7 py-3.5 text-lg font-semibold text-white transition hover:bg-celeste-600">Ser voluntario</a>
      </div>
    </div>
  </section>
</BaseLayout>
