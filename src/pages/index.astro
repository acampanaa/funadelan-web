---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icono from '@/components/Icono.astro';
import { getUltimasNoticias, getUltimosPosts, urlForImage, formatearFecha } from '@/lib/sanity';

const programas = [
  {
    numero: '01',
    titulo: 'Centro Diurno “Ángeluz”',
    descripcion:
      'Atención diurna integral para adultos mayores: salud, recreación, alimentación y compañía.',
    href: '/programas/actividades-sociales',
  },
  {
    numero: '02',
    titulo: 'Universidad del Adulto Mayor',
    descripcion:
      'Formación, cultura y desarrollo personal para seguir aprendiendo y compartiendo a cualquier edad.',
    href: '/programas/universidad-adulto-mayor',
  },
  {
    numero: '03',
    titulo: 'Red Mundial del Adulto Mayor',
    descripcion:
      'Una red de aliados y comunidades unidas por la dignidad y los derechos de las personas mayores.',
    href: '/programas/red-mundial',
  },
  {
    numero: '04',
    titulo: 'Bazar de los Ángeles',
    descripcion:
      'Nuestro evento de recaudación anual: venta de figuras religiosas de ángeles a beneficio de la fundación.',
    href: '/programas/bazar-de-los-angeles',
  },
];

const cifras = [
  { valor: '+15', etiqueta: 'años de labor social' },
  { valor: '+200', etiqueta: 'adultos mayores acompañados' },
  { valor: '+30', etiqueta: 'voluntarios y aliados' },
  { valor: '1', etiqueta: 'misión: vivir para servir' },
];

const valores = [
  { titulo: 'Fe', texto: 'Una esperanza que se convierte en presencia y servicio.' },
  { titulo: 'Dignidad', texto: 'Cada persona mayor merece respeto, cuidado y compañía.' },
  { titulo: 'Comunidad', texto: 'Familias, voluntarios y aliados trabajando juntos.' },
];

const noticiasSanity = await getUltimasNoticias(3);
const noticiasEjemplo = [
  {
    _id: 'ej-1',
    titulo: 'Próximamente: Chocolate para el Alma',
    resumen: 'Nuestro evento anual regresa el 15 de noviembre.',
    fechaLabel: '15 nov',
    href: '/noticias',
    imagen: null,
  },
  {
    _id: 'ej-2',
    titulo: 'Novena de octubre',
    resumen: 'Acompáñanos en la novena hasta el 2 de octubre.',
    fechaLabel: '02 oct',
    href: '/noticias',
    imagen: null,
  },
  {
    _id: 'ej-3',
    titulo: 'Bazar de los Ángeles',
    resumen: 'Un espacio de encuentro solidario para toda la comunidad.',
    fechaLabel: 'Pronto',
    href: '/noticias',
    imagen: null,
  },
];

const noticias =
  Array.isArray(noticiasSanity) && noticiasSanity.length > 0
    ? noticiasSanity.map((noticia: any) => ({
        _id: noticia._id,
        titulo: noticia.titulo,
        resumen: noticia.resumen,
        fechaLabel: formatearFecha(noticia.fecha, { day: '2-digit', month: 'short' }),
        href: `/noticias/${noticia.slug}`,
        imagen: noticia.imagen,
      }))
    : noticiasEjemplo;

const posts = (await getUltimosPosts(3)) || [];
---

<BaseLayout
  description="FUNADELÁN acompaña con fe, dignidad y servicio a las personas mayores de Portoviejo, Manabí."
>
  <section class="border-b border-celeste-800 bg-celeste-900 text-white">
    <div class="mx-auto max-w-[90rem] p-0 sm:p-4 lg:p-6">
      <div class="relative min-h-[38rem] overflow-hidden sm:min-h-[42rem]">
        <img
          src="/img/derechos-adulto-mayor/derecho-01-principal.jpg"
          alt="Personas mayores, familias y voluntarios durante una actividad comunitaria de FUNADELÁN"
          width="900"
          height="575"
          fetchpriority="high"
          class="absolute inset-0 h-full w-full object-cover object-center"
        />
        <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(25,18,15,.88)_0%,rgba(25,18,15,.62)_48%,rgba(25,18,15,.1)_100%)]" aria-hidden="true"></div>

        <!-- El ángel de la fundación. Va como decoración (aria-hidden y alt
             vacío): el mensaje de la portada ya está en el h1, y anunciarlo
             a un lector de pantalla solo añadiría ruido.
             Se ubica a la izquierda, detrás del texto "Vivir para servir"
             (el h1 va después en el DOM, así que queda por encima). -->
        <!-- Halo oscuro detrás del ángel. La estatua es blanca y la foto de
             fondo está llena de gente vestida de claro, así que sin esto la
             figura se confunde con la multitud. Oscurecer solo esa zona la
             despega sin apagar el resto de la fotografía. -->
        <div
          class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_40%_52%,rgba(25,18,15,.85)_0%,rgba(25,18,15,.55)_36%,transparent_68%)] sm:bg-[radial-gradient(circle_at_24%_42%,rgba(25,18,15,.85)_0%,rgba(25,18,15,.55)_38%,transparent_70%)]"
          aria-hidden="true"
        >
        </div>

        <div
          class="pointer-events-none absolute inset-0 flex items-end justify-start"
          aria-hidden="true"
        >
          <img
            src="/img/hero/angel.jpg"
            alt=""
            width="552"
            height="611"
            loading="eager"
            class="mascara-angel ml-2 mb-28 h-[34%] w-auto opacity-80 sm:ml-6 sm:mb-36 sm:h-[50%] lg:ml-10 lg:mb-44 lg:h-[60%]"
          />
        </div>

        <div class="relative flex min-h-[38rem] items-end sm:min-h-[42rem]">
          <div class="w-full max-w-3xl px-5 pb-10 pt-28 sm:px-10 sm:pb-14 lg:px-16 lg:pb-16">
            <p class="text-sm font-bold uppercase tracking-[0.13em] text-dorado-300">
              Fundación Amigos de los Ángeles · Portoviejo
            </p>
            <h1 class="mt-4 max-w-2xl font-display text-5xl font-semibold leading-[1.02] text-white sm:text-6xl lg:text-7xl">
              Vivir para servir
            </h1>
            <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/85 sm:text-xl">
              Acompañamos a las personas mayores con salud, formación, recreación y una comunidad que reconoce su dignidad.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-4">
              <!-- Donaciones temporalmente deshabilitadas. Volver a activar cuando esté listo.
              <a
                href="/colabora/donar"
                class="inline-flex min-h-12 items-center gap-2 border border-dorado-500 bg-dorado-400 px-6 py-3 font-bold text-celeste-900 hover:bg-dorado-300"
              >
                <Icono name="corazon" class="h-5 w-5" />
                Quiero colaborar
              </a>
              -->
              <a href="/quienes-somos" class="text-link min-h-12 px-1 text-white decoration-white/45 hover:text-white">
                Conoce la fundación
                <Icono name="flecha" class="h-5 w-5" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-arena-200 bg-crema" aria-label="Cifras de la fundación">
    <div class="mx-auto grid max-w-6xl grid-cols-2 px-4 lg:grid-cols-4">
      {
        cifras.map((cifra, index) => (
          <div class:list={['py-7 pr-5 sm:py-9', index % 2 !== 0 && 'pl-5', index > 0 && 'lg:border-l lg:border-arena-200 lg:pl-7']}>
            <p class="font-display text-3xl font-semibold tabular-nums text-celeste-700 sm:text-4xl">{cifra.valor}</p>
            <p class="mt-1 text-sm leading-snug text-tinta/65 sm:text-base">{cifra.etiqueta}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-20 sm:py-24 lg:grid-cols-[.8fr_1.2fr] lg:gap-20">
      <div>
        <p class="antetitulo">Quiénes somos</p>
        <h2 class="mt-4 text-4xl text-celeste-900 sm:text-5xl">La vejez también es futuro</h2>
      </div>
      <div class="border-t border-celeste-700 pt-6">
        <p class="max-w-2xl text-xl leading-relaxed text-tinta/85">
          Desde hace más de 15 años, FUNADELÁN reúne a personas mayores, familias,
          voluntarios y aliados para que envejecer en Portoviejo signifique seguir
          aprendiendo, participando y siendo parte de la comunidad.
        </p>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-tinta/70">
          Nuestra fe se expresa en acciones concretas: atención, compañía, formación y
          espacios donde cada historia de vida es escuchada y valorada.
        </p>
        <a href="/quienes-somos/la-fundacion" class="text-link mt-7">
          Leer nuestra historia
          <Icono name="flecha" class="h-5 w-5" />
        </a>
      </div>
    </div>
  </section>

  <section class="border-y border-arena-200 bg-arena-50" id="programas">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:py-24">
      <div class="grid gap-5 lg:grid-cols-[1fr_1fr] lg:items-end">
        <div>
          <p class="antetitulo">Lo que hacemos</p>
          <h2 class="mt-4 text-4xl text-celeste-900 sm:text-5xl">Programas con continuidad</h2>
        </div>
        <p class="max-w-xl text-lg text-tinta/70 lg:justify-self-end">
          Acompañamiento diario, formación y trabajo en red. Cuatro líneas de acción con objetivos claros.
        </p>
      </div>

      <div class="mt-12 border-b border-arena-200">
        {
          programas.map((programa) => (
            <article class="group grid gap-4 border-t border-arena-200 py-7 md:grid-cols-[4rem_1fr_1.15fr_auto] md:items-center md:gap-8">
              <p class="text-sm font-bold tabular-nums tracking-[0.08em] text-celeste-600">{programa.numero}</p>
              <h3 class="text-2xl text-celeste-900">{programa.titulo}</h3>
              <p class="max-w-xl text-base leading-relaxed text-tinta/70">{programa.descripcion}</p>
              <a href={programa.href} class="inline-flex min-h-11 items-center gap-2 font-bold text-celeste-700 underline decoration-celeste-200 underline-offset-4 group-hover:decoration-celeste-700">
                Ver programa
                <Icono name="flecha" class="h-5 w-5" />
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-crema">
    <div class="mx-auto grid max-w-6xl lg:grid-cols-[1.05fr_.95fr]">
      <figure class="min-h-[30rem] lg:min-h-[44rem]">
        <img
          src="/img/derechos-adulto-mayor/derecho-07-detail-accent.jpg"
          alt="Personas mayores compartiendo una comida durante un encuentro de la fundación"
          width="900"
          height="1200"
          loading="lazy"
          class="h-full min-h-[30rem] w-full object-cover lg:min-h-[44rem]"
        />
      </figure>
      <div class="flex flex-col justify-center px-6 py-14 sm:px-10 sm:py-20 lg:px-16">
        <p class="antetitulo">Cómo trabajamos</p>
        <h2 class="mt-4 text-4xl text-celeste-900">Cerca de las personas, todos los días</h2>
        <p class="mt-6 text-lg leading-relaxed text-tinta/70">
          El cuidado no ocurre en abstracto. Se construye en una mesa compartida, una
          conversación, una consulta, un taller y el compromiso sostenido de muchas manos.
        </p>
        <dl class="mt-9 border-b border-arena-200">
          {
            valores.map((valor) => (
              <div class="grid gap-2 border-t border-arena-200 py-5 sm:grid-cols-[8rem_1fr] sm:gap-5">
                <dt class="font-bold text-celeste-700">{valor.titulo}</dt>
                <dd class="text-base text-tinta/70">{valor.texto}</dd>
              </div>
            ))
          }
        </dl>
        <a href="/quienes-somos/mision-vision" class="text-link mt-7">
          Nuestra misión y visión
          <Icono name="flecha" class="h-5 w-5" />
        </a>
      </div>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="border-y border-arena-200 bg-white">
        <div class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
          <div class="flex flex-wrap items-end justify-between gap-5">
            <div>
              <p class="antetitulo">Nuestra comunidad</p>
              <h2 class="mt-3 text-3xl text-celeste-900 sm:text-4xl">Publicaciones recientes</h2>
            </div>
          </div>
          <div class="mt-9 grid gap-8 md:grid-cols-3">
            {posts.map((post: any) => (
              <a href={`/posts/${post.slug}`} class="group block border-t border-celeste-700 pt-4">
                {post.imagenes?.[0] && (
                  <img
                    src={urlForImage(post.imagenes[0]).width(800).height(520).fit('crop').url()}
                    alt=""
                    width="800"
                    height="520"
                    loading="lazy"
                    class="mb-5 aspect-[8/5] w-full object-cover"
                  />
                )}
                <p class="text-sm font-bold uppercase tracking-[0.08em] text-celeste-600">
                  {formatearFecha(post.fecha, { day: '2-digit', month: 'short', year: 'numeric' })}
                </p>
                <h3 class="mt-2 text-2xl group-hover:text-celeste-700">{post.titulo}</h3>
                {post.resumen && <p class="mt-3 text-base text-tinta/70">{post.resumen}</p>}
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="bg-white" id="noticias">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:py-24">
      <div class="flex flex-wrap items-end justify-between gap-5">
        <div>
          <p class="antetitulo">Actualidad</p>
          <h2 class="mt-3 text-4xl text-celeste-900 sm:text-5xl">Noticias de FUNADELÁN</h2>
        </div>
        <a href="/noticias" class="text-link">
          Ver todas las noticias
          <Icono name="flecha" class="h-5 w-5" />
        </a>
      </div>

      <div class="mt-12 grid gap-8 md:grid-cols-3">
        {
          noticias.map((noticia) => (
            <a href={noticia.href} class="group flex h-full flex-col border-t border-celeste-700 pt-4">
              {noticia.imagen && (
                <img
                  src={urlForImage(noticia.imagen).width(800).height(520).fit('crop').url()}
                  alt=""
                  width="800"
                  height="520"
                  loading="lazy"
                  class="mb-5 aspect-[8/5] w-full object-cover"
                />
              )}
              <p class="text-sm font-bold uppercase tracking-[0.08em] text-celeste-600">{noticia.fechaLabel}</p>
              <h3 class="mt-2 text-2xl group-hover:text-celeste-700">{noticia.titulo}</h3>
              <p class="mt-3 flex-1 text-base text-tinta/70">{noticia.resumen}</p>
              <span class="mt-5 inline-flex items-center gap-2 font-bold text-celeste-700">
                Leer noticia
                <Icono name="flecha" class="h-5 w-5" />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-y border-celeste-800 bg-celeste-700 text-white">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-14 sm:py-16 lg:grid-cols-[1.25fr_.75fr] lg:items-center">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.12em] text-dorado-200">Tu ayuda sostiene el trabajo</p>
        <h2 class="mt-3 text-4xl text-white sm:text-5xl">Hay muchas formas de servir</h2>
        <p class="mt-4 max-w-2xl text-lg text-white/80">
          Puedes ofrecer tu tiempo o ayudar a que más personas conozcan nuestra labor.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 lg:justify-end">
        <!-- Donaciones temporalmente deshabilitadas. Volver a activar cuando esté listo.
        <a href="/colabora/donar" class="inline-flex min-h-12 items-center bg-dorado-400 px-6 py-3 font-bold text-celeste-900 hover:bg-dorado-300">
          Donar ahora
        </a>
        -->
        <a href="/colabora/voluntariado" class="inline-flex min-h-12 items-center border border-white/55 px-6 py-3 font-bold text-white hover:bg-white/10">
          Ser voluntario
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
