---
import PageLayout from '@/layouts/PageLayout.astro';
import Placeholder from '@/components/Placeholder.astro';
import Icono from '@/components/Icono.astro';
import { PortableText } from 'astro-portabletext';
import { getOraciones, urlForImage } from '@/lib/sanity';

const breadcrumbs = [{ label: 'Espiritualidad', href: '/espiritualidad' }];

const oraciones = await getOraciones();
---

<PageLayout
  title="Oraciones"
  lead="Oraciones a los Santos Ángeles para acompañar la vida de fe de nuestra comunidad."
  breadcrumbs={breadcrumbs}
>
  {
    !oraciones || oraciones.length === 0 ? (
      <Placeholder note="Aún no hay oraciones publicadas. Agrégalas en Sanity Studio (tipo «Oración»)." />
    ) : (
      <div class="mx-auto flex max-w-xl flex-col gap-8">
        {oraciones.map((o: any) => (
          <article class="overflow-hidden rounded-2xl border border-arena-200/70 bg-white shadow-[var(--shadow-suave)]">
            {/* Cabecera tipo red social */}
            <header class="flex items-center gap-3 p-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-celeste-700 text-dorado-300">
                <Icono name="estrella" class="h-6 w-6" />
              </span>
              <div class="min-w-0">
                <p class="truncate font-display text-lg leading-tight text-celeste-800">{o.titulo}</p>
                {o.fuente && <p class="truncate text-sm text-tinta/60">{o.fuente}</p>}
              </div>
            </header>

            {o.imagen && (
              <img
                src={urlForImage(o.imagen).width(1080).url()}
                alt={o.titulo}
                class="w-full"
                loading="lazy"
              />
            )}

            {o.texto && o.texto.length > 0 && (
              <div class="richtext px-5 py-5 text-tinta/85">
                <PortableText value={o.texto} />
              </div>
            )}
          </article>
        ))}
      </div>
    )
  }
</PageLayout>

<style>
  .richtext :global(p) {
    margin-bottom: 1rem;
  }
  .richtext :global(p:last-child) {
    margin-bottom: 0;
  }
  .richtext :global(em) {
    font-style: italic;
  }
  .richtext :global(strong) {
    font-weight: 600;
  }
</style>
