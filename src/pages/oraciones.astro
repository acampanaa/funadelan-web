---
import PageLayout from '@/layouts/PageLayout.astro';
import Placeholder from '@/components/Placeholder.astro';
import Icono from '@/components/Icono.astro';
import { PortableText } from 'astro-portabletext';
import { getOraciones, urlForImage } from '@/lib/sanity';

const breadcrumbs = [{ label: 'Espiritualidad', href: '/espiritualidad' }];

const oraciones = await getOraciones();
---

<PageLayout
  title="Oraciones"
  lead="Oraciones a los Santos Ángeles para acompañar la vida de fe de nuestra comunidad."
  breadcrumbs={breadcrumbs}
>
  {
    !oraciones || oraciones.length === 0 ? (
      <Placeholder note="Aún no hay oraciones publicadas. Agrégalas en Sanity Studio (tipo «Oración»)." />
    ) : (
      <div class="mx-auto flex max-w-2xl flex-col gap-10">
        {oraciones.map((o: any) => (
          <article class="rounded-2xl border border-arena-200/70 bg-white p-8 text-center shadow-[var(--shadow-suave)] sm:p-10">
            {o.imagen ? (
              <img
                src={urlForImage(o.imagen).width(400).height(400).fit('crop').url()}
                alt={o.titulo}
                class="mx-auto mb-6 aspect-square w-28 rounded-full object-cover"
                loading="lazy"
              />
            ) : (
              <span class="mx-auto mb-6 grid h-14 w-14 place-items-center rounded-full bg-celeste-700 text-dorado-300">
                <Icono name="estrella" class="h-6 w-6" />
              </span>
            )}

            <h2 class="font-display text-2xl text-celeste-800">{o.titulo}</h2>

            {o.texto && o.texto.length > 0 && (
              <div class="richtext mt-5 font-display text-xl italic leading-relaxed text-tinta/85">
                <PortableText value={o.texto} />
              </div>
            )}

            {o.fuente && <p class="mt-5 text-sm text-tinta/70">— {o.fuente}</p>}
          </article>
        ))}
      </div>
    )
  }
</PageLayout>

<style>
  .richtext :global(p) {
    margin-bottom: 1rem;
  }
  .richtext :global(p:last-child) {
    margin-bottom: 0;
  }
  .richtext :global(em) {
    font-style: italic;
  }
  .richtext :global(strong) {
    font-weight: 600;
  }
</style>
