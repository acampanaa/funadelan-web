---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icono from '@/components/Icono.astro';

/**
 * Página 404 personalizada con el sistema de diseño de FUNADELÁN.
 * Netlify la sirve automáticamente cuando ninguna ruta coincide.
 */
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscas no existe o fue movida. Visita la página principal de FUNADELÁN."
>
  <section class="relative flex flex-1 flex-col items-center justify-center overflow-hidden bg-celeste-900 text-white">
    <!-- Fondo de marca -->
    <div class="cielo-estrellado pointer-events-none absolute inset-0 opacity-50" aria-hidden="true"></div>
    <div class="halo-dorado animate-halo pointer-events-none absolute -right-20 -top-20 h-[28rem] w-[28rem]" aria-hidden="true"></div>
    <div class="halo-dorado animate-halo pointer-events-none absolute -bottom-20 -left-20 h-[20rem] w-[20rem]" aria-hidden="true" style="animation-delay: 3s;"></div>

    <div class="relative mx-auto max-w-2xl px-4 py-24 text-center">
      <!-- Símbolo de marca -->
      <svg viewBox="0 0 64 64" class="mx-auto h-16 w-16 opacity-60" aria-hidden="true">
        <path d="M32 7 C33.6 24 40 30.4 57 32 C40 33.6 33.6 40 32 57 C30.4 40 24 33.6 7 32 C24 30.4 30.4 24 32 7 Z" fill="#f1d792" />
      </svg>

      <!-- Código de error -->
      <p class="mt-6 font-display text-8xl font-bold text-dorado-300/70 sm:text-9xl">404</p>

      <h1 class="mt-4 font-display text-3xl font-semibold text-white sm:text-4xl">
        Página no encontrada
      </h1>
      <p class="mx-auto mt-4 max-w-md text-lg text-celeste-200">
        La página que buscas no existe o fue movida. Puedes volver al inicio
        o explorar nuestros programas.
      </p>
      <p class="mt-3 font-display text-xl italic text-dorado-300">«Vivir para servir»</p>

      <!-- Acciones -->
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a
          href="/"
          class="inline-flex items-center gap-2 rounded-full bg-dorado-400 px-7 py-3.5 text-lg font-semibold text-celeste-900 shadow-lg transition hover:-translate-y-0.5 hover:bg-dorado-300"
        >
          <Icono name="estrella" class="h-5 w-5" />
          Ir al inicio
        </a>
        <a
          href="/quienes-somos"
          class="inline-flex items-center gap-2 rounded-full border border-celeste-300/60 px-7 py-3.5 text-lg font-semibold text-white transition hover:bg-white/10"
        >
          Conócenos
          <Icono name="flecha" class="h-5 w-5" />
        </a>
      </div>

      <!-- Links rápidos -->
      <div class="mt-12 flex flex-wrap justify-center gap-x-6 gap-y-2">
        {[
          { label: 'Programas', href: '/programas' },
          { label: 'Noticias', href: '/noticias' },
          { label: 'Colabora', href: '/colabora' },
          { label: 'Donar', href: '/colabora/donar' },
        ].map((link) => (
          <a
            href={link.href}
            class="text-base text-celeste-300 underline underline-offset-4 transition hover:text-white"
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
