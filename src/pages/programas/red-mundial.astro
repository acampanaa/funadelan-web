---
import PageLayout from '@/layouts/PageLayout.astro';
import Placeholder from '@/components/Placeholder.astro';
import ListaProyectos from '@/components/ListaProyectos.astro';
import { getProyectos } from '@/lib/sanity';

const breadcrumbs = [{ label: 'Programas', href: '/programas' }];

const proyectos = await getProyectos('red-mundial');
---

<PageLayout
  title="Red Mundial del Adulto Mayor"
  lead="Una red de aliados unidos por la dignidad de las personas mayores."
  breadcrumbs={breadcrumbs}
>
  <ListaProyectos proyectos={proyectos}>
    <Placeholder note="Aún no hay contenido publicado. Agrégalo en Sanity Studio (tipo «Proyecto / Programa», categoría «Red Mundial del Adulto Mayor»)." />
  </ListaProyectos>
</PageLayout>
