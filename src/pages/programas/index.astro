---
import PageLayout from '@/layouts/PageLayout.astro';

const breadcrumbs = [];

const programas = [
  {
    nombre: 'CAIMHA',
    descripcion: 'Centro de Atención Integral Manabí Humano Angeluz: servicios de salud, acompañamiento y bienestar.',
    href: '/programas/actividades-sociales',
  },
  {
    nombre: 'Novena de los Ángeles',
    descripcion: 'Nueve días de oración y encuentro para fortalecer la fe de nuestra comunidad.',
    href: '/programas/novena-de-los-angeles',
  },
  {
    nombre: 'Chocolate del Alma',
    descripcion: 'Un encuentro solidario que reúne a la comunidad y sostiene la labor de FUNADELÁN.',
    href: '/programas/chocolate-del-alma',
  },
  {
    nombre: 'Bazar de los Ángeles',
    descripcion: 'Figuras religiosas de ángeles cuya venta ayuda a financiar nuestros programas.',
    href: '/programas/bazar-de-los-angeles',
  },
];
---

<PageLayout
  title="Programas"
  lead="Iniciativas que unen atención, espiritualidad y solidaridad."
  breadcrumbs={breadcrumbs}
>
  <div class="grid gap-6 sm:grid-cols-2">
    {programas.map((programa, indice) => (
      <a
        href={programa.href}
        class="group flex min-h-64 flex-col rounded-2xl border border-celeste-100 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
      >
        <span class="text-sm font-semibold uppercase tracking-[0.16em] text-dorado-700">
          {String(indice + 1).padStart(2, '0')}
        </span>
        <h2 class="mt-4 text-2xl text-celeste-800">{programa.nombre}</h2>
        <p class="mt-3 flex-1 text-base leading-relaxed text-tinta/75">{programa.descripcion}</p>
        <span class="mt-6 font-semibold text-celeste-600 underline-offset-4 group-hover:underline">Conocer el programa →</span>
      </a>
    ))}
  </div>
</PageLayout>