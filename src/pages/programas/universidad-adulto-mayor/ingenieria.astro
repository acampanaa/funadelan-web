---
import PageLayout from '@/layouts/PageLayout.astro';
import ContenidoEditable from '@/components/ContenidoEditable.astro';
import { getPaginaEstatica } from '@/lib/sanity';

const breadcrumbs = [
  { label: 'Programas', href: '/programas' },
  { label: 'Universidad del Adulto Mayor', href: '/programas/universidad-adulto-mayor' },
];

const pagina = await getPaginaEstatica('uam-ingenieria');
const lead = pagina?.lead || 'Planimetría y desarrollo técnico del proyecto.';
---

<PageLayout title="Ingeniería (planimetría)" lead={lead} breadcrumbs={breadcrumbs}>
  <ContenidoEditable cuerpo={pagina?.cuerpo}>
    <p class="max-w-3xl text-lg text-tinta/85">
      Esta sección presentará la planimetría y el desarrollo técnico de la
      Universidad del Adulto Mayor. El contenido se editará desde Sanity Studio
      (página estática con clave «uam-ingenieria»).
    </p>
  </ContenidoEditable>
</PageLayout>
