---
import PageLayout from '@/layouts/PageLayout.astro';
import Placeholder from '@/components/Placeholder.astro';
import ListaProyectos from '@/components/ListaProyectos.astro';
import { getProyectos } from '@/lib/sanity';

const breadcrumbs = [{ label: 'Programas', href: '/programas' }];

const proyectos = await getProyectos('uam');
---

<PageLayout
  title="Universidad del Adulto Mayor"
  lead="Formación, cultura y desarrollo personal a cualquier edad."
  breadcrumbs={breadcrumbs}
>
  <ListaProyectos proyectos={proyectos}>
    <Placeholder note="Aún no hay contenido publicado. Agrégalo en Sanity Studio (tipo «Proyecto / Programa», categoría «Universidad del Adulto Mayor»)." />
  </ListaProyectos>

  <div class="mt-12 grid gap-6 sm:grid-cols-2">
    <a
      href="/programas/universidad-adulto-mayor/ingenieria"
      class="group flex flex-col rounded-2xl border border-celeste-100 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
    >
      <h2 class="text-xl text-celeste-800">Ingeniería (planimetría)</h2>
      <p class="mt-2 flex-1 text-base text-tinta/75">Planimetría y desarrollo técnico del proyecto.</p>
      <span class="mt-4 font-semibold text-celeste-600 group-hover:text-celeste-500 group-hover:underline underline-offset-4">Ver más →</span>
    </a>
    <a
      href="/programas/universidad-adulto-mayor/arquitectura"
      class="group flex flex-col rounded-2xl border border-celeste-100 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
    >
      <h2 class="text-xl text-celeste-800">Arquitectura (nueva propuesta)</h2>
      <p class="mt-2 flex-1 text-base text-tinta/75">Nueva propuesta de diseño arquitectónico.</p>
      <span class="mt-4 font-semibold text-celeste-600 group-hover:text-celeste-500 group-hover:underline underline-offset-4">Ver más →</span>
    </a>
  </div>
</PageLayout>
