---
import PageLayout from '@/layouts/PageLayout.astro';
import Icono from '@/components/Icono.astro';
import { getEventos, urlForImage, formatearFecha } from '@/lib/sanity';

const breadcrumbs = [{ label: 'Espiritualidad', href: '/espiritualidad' }];
const eventos = await getEventos();

const secciones = [
  {
    id: 'sociales',
    titulo: 'Eventos sociales',
    descripcion: 'Encuentros solidarios, culturales y comunitarios.',
    eventos: eventos.filter((evento: any) => evento.tipo === 'social'),
  },
  {
    id: 'espirituales',
    titulo: 'Eventos espirituales',
    descripcion: 'Novenas, celebraciones y encuentros de fe.',
    eventos: eventos.filter((evento: any) => evento.tipo === 'espiritual'),
  },
];
---

<PageLayout
  title="Eventos"
  lead="Encuentros sociales, solidarios y espirituales de FUNADELÁN."
  breadcrumbs={breadcrumbs}
>
  <div class="space-y-16">
    {secciones.map((seccion) => (
      <section aria-labelledby={`titulo-${seccion.id}`}>
        <div class="mb-6 border-b border-arena-200 pb-5">
          <p class="antetitulo">{seccion.id}</p>
          <h2 id={`titulo-${seccion.id}`} class="mt-2 text-3xl text-celeste-900">{seccion.titulo}</h2>
          <p class="mt-2 text-base text-tinta/70">{seccion.descripcion}</p>
        </div>

        {seccion.eventos.length === 0 ? (
          <p class="rounded-2xl border border-dashed border-celeste-200 bg-celeste-50/40 px-6 py-8 text-base text-tinta/70">
            Aún no hay {seccion.titulo.toLowerCase()} publicados.
          </p>
        ) : (
          <div class="grid gap-6 md:grid-cols-2">
            {seccion.eventos.map((evento: any) => (
              <a
                href={`/espiritualidad/eventos/${evento.slug}`}
                class="group flex flex-col overflow-hidden rounded-2xl border border-celeste-100 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
              >
                {evento.imagen ? (
                  <img
                    src={urlForImage(evento.imagen).width(800).height(480).fit('crop').url()}
                    alt={evento.titulo}
                    width="800"
                    height="480"
                    class="aspect-[5/3] w-full object-cover"
                    loading="lazy"
                  />
                ) : (
                  <div class="grid aspect-[5/3] place-items-center bg-gradient-to-br from-celeste-100 to-dorado-100 text-5xl text-celeste-700" aria-hidden="true">✦</div>
                )}
                <div class="flex flex-1 flex-col p-6">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm font-semibold uppercase tracking-wide text-dorado-700">
                    <span>{evento.tipo === 'social' ? 'Social' : 'Espiritual'}</span>
                    <span aria-hidden="true">·</span>
                    <span>
                      {formatearFecha(evento.fechaInicio)}
                      {evento.fechaFin && ` — ${formatearFecha(evento.fechaFin)}`}
                    </span>
                  </div>
                  <h3 class="mt-2 text-2xl text-celeste-900">{evento.titulo}</h3>
                  {evento.lugar && (
                    <p class="mt-2 flex items-start gap-2 text-base text-tinta/70">
                      <Icono name="ubicacion" class="mt-0.5 h-5 w-5 shrink-0 text-celeste-600" />
                      <span>{evento.lugar}</span>
                    </p>
                  )}
                  {evento.resumen && <p class="mt-4 flex-1 text-base leading-relaxed text-tinta/75">{evento.resumen}</p>}
                  <span class="mt-6 font-semibold text-celeste-600 underline-offset-4 group-hover:underline">Ver evento →</span>
                </div>
              </a>
            ))}
          </div>
        )}
      </section>
    ))}
  </div>
</PageLayout>