---
import PageLayout from '@/layouts/PageLayout.astro';
import Placeholder from '@/components/Placeholder.astro';
import { getReflexiones, formatearFecha, urlForImage } from '@/lib/sanity';

const breadcrumbs = [{ label: 'Espiritualidad', href: '/espiritualidad' }];

const reflexiones = await getReflexiones();
---

<PageLayout
  title="Reflexiones y mensajes"
  lead="Palabras para el alma, inspiradas en los Ángeles como mensajeros de Dios."
  breadcrumbs={breadcrumbs}
>
  {
    !reflexiones || reflexiones.length === 0 ? (
      <Placeholder note="Aún no hay reflexiones publicadas. Agrégalas en Sanity Studio (tipo «Reflexión / Mensaje»)." />
    ) : (
      <div class="mx-auto max-w-3xl divide-y divide-celeste-100">
        {reflexiones.map((r: any) => (
          <a
            href={r.slug ? `/espiritualidad/reflexiones/${r.slug}` : '#'}
            class="group flex items-center gap-5 py-6"
          >
            {r.imagen && (
              <img
                src={urlForImage(r.imagen).width(200).height(200).fit('crop').url()}
                alt=""
                class="h-20 w-20 shrink-0 rounded-xl object-cover"
                loading="lazy"
              />
            )}
            <div class="flex min-w-0 flex-col gap-1">
              <h2 class="text-2xl text-celeste-800 transition group-hover:text-celeste-500 group-hover:underline underline-offset-4">{r.titulo}</h2>
              <p class="text-base text-tinta/70">
                {[r.autor, formatearFecha(r.fecha)].filter(Boolean).join(' · ')}
              </p>
              <span class="mt-1 font-semibold text-celeste-600">Leer →</span>
            </div>
          </a>
        ))}
      </div>
    )
  }
</PageLayout>
