---
import PageLayout from '@/layouts/PageLayout.astro';
import ContenidoEditable from '@/components/ContenidoEditable.astro';
import Icono from '@/components/Icono.astro';
import { getPaginaEstatica } from '@/lib/sanity';

const breadcrumbs = [];

const pagina = await getPaginaEstatica('colabora');
const lead = pagina?.lead || 'Hay muchas formas de sumarte a la misión.';

const formas = [
  // Donaciones temporalmente deshabilitadas. Volver a activar cuando esté listo.
  // { titulo: 'Donar', descripcion: 'Tu aporte sostiene el acompañamiento diario a las personas mayores.', href: '/colabora/donar', icono: 'corazon' as const },
  { titulo: 'Voluntariado', descripcion: 'Comparte tu tiempo y talento con quienes más lo necesitan.', href: '/colabora/voluntariado', icono: 'personas' as const },
  { titulo: 'Rendición de cuentas', descripcion: 'Conoce con transparencia cómo usamos cada recurso.', href: '/colabora/rendicion-de-cuentas', icono: 'brujula' as const },
  { titulo: 'Contacto', descripcion: 'Escríbenos para conocer otras formas de colaborar.', href: '/colabora/contacto', icono: 'correo' as const },
];
---

<PageLayout title="Colabora" lead={lead} breadcrumbs={breadcrumbs}>
  <ContenidoEditable cuerpo={pagina?.cuerpo}>
    <p class="max-w-3xl text-lg text-tinta/85">
      Cada gesto cuenta. Como donante, voluntario o aliado, tu apoyo hace
      posible que sigamos sirviendo con amor y dignidad a las personas mayores.
    </p>
  </ContenidoEditable>

  <div class="mt-10 border-b border-arena-200">
    {
      formas.map((f) => (
        <a
          href={f.href}
          class="group grid gap-3 border-t border-arena-200 py-6 sm:grid-cols-[3rem_12rem_1fr_auto] sm:items-center sm:gap-6"
        >
          <Icono name={f.icono} class="h-8 w-8 text-celeste-700" />
          <h2 class="text-2xl">{f.titulo}</h2>
          <p class="text-base text-tinta/75">{f.descripcion}</p>
          <span class="font-bold text-celeste-700 underline decoration-celeste-200 underline-offset-4 group-hover:decoration-celeste-700">Ver más</span>
        </a>
      ))
    }
  </div>
</PageLayout>
