---
import PageLayout from '@/layouts/PageLayout.astro';
import Icono from '@/components/Icono.astro';
import CampoTelefono from '@/components/CampoTelefono.astro';

// Esta página lee el search param ?enviado=1 en el servidor (SSR).
export const prerender = false;

const breadcrumbs = [{ label: 'Colabora', href: '/colabora' }];

// /api/voluntariado redirige a ?enviado=1 tras un envío correcto.
// Astro 5 en modo híbrido permite leer search params en el servidor.
const enviado = Astro.url.searchParams.get('enviado') === '1';

// Campo "área de interés" — atiende el hueco #12 del documento de requisitos
// para segmentar mejor el voluntariado.
const areas = [
  'Acompañamiento a adultos mayores',
  'Eventos y logística',
  'Comunicación y redes sociales',
  'Salud y bienestar',
  'Recaudación de fondos',
  'Espiritualidad y pastoral',
  'Otra',
];
---

<PageLayout
  title="Voluntariado"
  lead="Dona tu tiempo y talento. Cuéntanos cómo te gustaría ayudar, en qué área y cuál es tu disponibilidad."
  breadcrumbs={breadcrumbs}
>
  {/* Banner de éxito: se muestra cuando el endpoint redirige con ?enviado=1 */}
  {enviado && (
    <div class="mb-10 flex items-start gap-4 rounded-2xl border border-dorado-300 bg-dorado-50 px-6 py-5">
      <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-dorado-200 text-celeste-800" aria-hidden="true">
        <Icono name="corazon" class="h-6 w-6" />
      </span>
      <div>
        <p class="text-xl font-semibold text-celeste-800">¡Gracias por querer ser voluntario/a!</p>
        <p class="mt-1 text-base text-tinta/80">
          Recibimos tu solicitud. Nos pondremos en contacto contigo pronto para coordinar los próximos pasos.
          Tu generosidad hace posible nuestra misión.
        </p>
        <a
          href="/"
          class="mt-4 inline-flex items-center gap-2 rounded-full border border-celeste-300 px-5 py-2 text-base font-semibold text-celeste-700 transition hover:bg-white"
        >
          Volver al inicio
        </a>
      </div>
    </div>
  )}
  {/* Formulario: se oculta si el formulario ya fue enviado */}
  {!enviado && (
  <form
    id="form-voluntariado"
    name="voluntariado"
    method="POST"
    action="/api/voluntariado"
    class="max-w-2xl space-y-5"
  >
    <p class="hidden" aria-hidden="true">
      <label>No llenar: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
    </p>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for="nombre" class="block text-base font-semibold text-celeste-800">Nombre completo</label>
        <input id="nombre" name="nombre" type="text" required
          class="mt-2 w-full rounded-xl border border-celeste-200 px-4 py-3 text-base focus:border-celeste-400" />
      </div>
      <div>
        <label for="email" class="block text-base font-semibold text-celeste-800">Correo electrónico</label>
        <input id="email" name="email" type="email" required
          class="mt-2 w-full rounded-xl border border-celeste-200 px-4 py-3 text-base focus:border-celeste-400" />
      </div>
    </div>

    <CampoTelefono />

    <div>
      <label for="area" class="block text-base font-semibold text-celeste-800">Área de interés / tipo de apoyo</label>
      <select id="area" name="area_de_interes" required
        class="mt-2 w-full rounded-xl border border-celeste-200 bg-white px-4 py-3 text-base focus:border-celeste-400">
        <option value="" disabled selected>Selecciona un área…</option>
        {areas.map((a) => <option value={a}>{a}</option>)}
      </select>
    </div>

    <div>
      <label for="disponibilidad" class="block text-base font-semibold text-celeste-800">Disponibilidad</label>
      <input id="disponibilidad" name="disponibilidad" type="text" placeholder="Ej. fines de semana, tardes…"
        class="mt-2 w-full rounded-xl border border-celeste-200 px-4 py-3 text-base focus:border-celeste-400" />
    </div>

    <div>
      <label for="mensaje" class="block text-base font-semibold text-celeste-800">¿Por qué quieres ser voluntario? (opcional)</label>
      <textarea id="mensaje" name="mensaje" rows="4"
        class="mt-2 w-full rounded-xl border border-celeste-200 px-4 py-3 text-base focus:border-celeste-400"></textarea>
    </div>

    <button type="submit"
      class="rounded-full bg-dorado-400 px-8 py-3.5 text-lg font-semibold text-celeste-900 transition hover:bg-dorado-300">
      Quiero ser voluntario
    </button>

    <p id="voluntariado-mensaje" class="text-base font-semibold" role="status" aria-live="polite"></p>
  </form>
  )}

  <script>
    // Sin JavaScript el formulario se envía solo y el endpoint responde con una
    // redirección a ?enviado=1. Con él, se envía por detrás para poder mostrar
    // el error sin perder lo que la persona ya escribió.
    const form = document.getElementById('form-voluntariado') as HTMLFormElement | null;
    const msg = document.getElementById('voluntariado-mensaje');
    const boton = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!msg || !boton) return;

      boton.disabled = true;
      msg.textContent = 'Enviando…';
      msg.style.color = '#a33818';

      try {
        const res = await fetch('/api/voluntariado', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const data = await res.json();
        if (data.ok) {
          window.location.href = '/colabora/voluntariado?enviado=1';
          return;
        }
        msg.textContent = data.error || 'Ocurrió un error. Intenta de nuevo.';
        msg.style.color = '#b91c1c';
      } catch {
        msg.textContent = 'No se pudo conectar. Intenta más tarde.';
        msg.style.color = '#b91c1c';
      } finally {
        boton.disabled = false;
      }
    });
  </script>
</PageLayout>
