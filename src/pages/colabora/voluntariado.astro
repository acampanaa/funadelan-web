---
import PageLayout from '@/layouts/PageLayout.astro';

const breadcrumbs = [{ label: 'Colabora', href: '/colabora' }];

// Campo "área de interés" — atiende el hueco #12 del documento de requisitos
// para segmentar mejor el voluntariado.
const areas = [
  'Acompañamiento a adultos mayores',
  'Eventos y logística',
  'Comunicación y redes sociales',
  'Salud y bienestar',
  'Recaudación de fondos',
  'Espiritualidad y pastoral',
  'Otra',
];
---

<PageLayout
  title="Voluntariado"
  lead="Dona tu tiempo y talento. Cuéntanos cómo te gustaría ayudar y nos pondremos en contacto."
  breadcrumbs={breadcrumbs}
>
  <form
    name="voluntariado"
    method="POST"
    data-netlify="true"
    netlify-honeypot="bot-field"
    action="/colabora/voluntariado?enviado=1"
    class="max-w-2xl space-y-5"
  >
    <input type="hidden" name="form-name" value="voluntariado" />
    <p class="hidden"><label>No llenar: <input name="bot-field" /></label></p>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for="nombre" class="block text-base font-semibold text-celeste-800">Nombre completo</label>
        <input id="nombre" name="nombre" type="text" required
          class="mt-2 w-full rounded-xl border border-celeste-200 px-4 py-3 text-base focus:border-celeste-400" />
      </div>
      <div>
        <label for="email" class="block text-base font-semibold text-celeste-800">Correo electrónico</label>
        <input id="email" name="email" type="email" required
          class="mt-2 w-full rounded-xl border border-celeste-200 px-4 py-3 text-base focus:border-celeste-400" />
      </div>
    </div>

    <div>
      <label for="area" class="block text-base font-semibold text-celeste-800">Área de interés / tipo de apoyo</label>
      <select id="area" name="area_de_interes" required
        class="mt-2 w-full rounded-xl border border-celeste-200 bg-white px-4 py-3 text-base focus:border-celeste-400">
        <option value="" disabled selected>Selecciona un área…</option>
        {areas.map((a) => <option value={a}>{a}</option>)}
      </select>
    </div>

    <div>
      <label for="disponibilidad" class="block text-base font-semibold text-celeste-800">Disponibilidad</label>
      <input id="disponibilidad" name="disponibilidad" type="text" placeholder="Ej. fines de semana, tardes…"
        class="mt-2 w-full rounded-xl border border-celeste-200 px-4 py-3 text-base focus:border-celeste-400" />
    </div>

    <div>
      <label for="mensaje" class="block text-base font-semibold text-celeste-800">¿Por qué quieres ser voluntario? (opcional)</label>
      <textarea id="mensaje" name="mensaje" rows="4"
        class="mt-2 w-full rounded-xl border border-celeste-200 px-4 py-3 text-base focus:border-celeste-400"></textarea>
    </div>

    <button type="submit"
      class="rounded-full bg-dorado-400 px-8 py-3.5 text-lg font-semibold text-celeste-900 transition hover:bg-dorado-300">
      Quiero ser voluntario
    </button>
  </form>
</PageLayout>
