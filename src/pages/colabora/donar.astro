---
import PageLayout from '@/layouts/PageLayout.astro';

const breadcrumbs = [{ label: 'Colabora', href: '/colabora' }];

// Estas variables son públicas porque se usan en enlaces e imágenes que ve el visitante.
// No incluir aquí credenciales, llaves privadas ni datos bancarios.
const kushkiPaymentUrl = import.meta.env.PUBLIC_KUSHKI_PAYMENT_URL?.trim() ?? '';
const donationQrUrl = import.meta.env.PUBLIC_DONATION_QR_URL?.trim() ?? '';
---

<PageLayout
  title="Donar"
  lead="Tu donación sostiene el acompañamiento diario a las personas mayores. Cada aporte cuenta."
  breadcrumbs={breadcrumbs}
>
  <div class="grid gap-10 lg:grid-cols-[1.3fr_1fr]">
    <div>
      <h2 class="text-2xl">Donación en línea</h2>
      <p class="mt-2 text-base text-tinta/75">
        El pago se realiza de forma segura en la plataforma de Kushki. FUNADELÁN no almacena
        datos de tarjetas.
      </p>

      {
        kushkiPaymentUrl ? (
          <a
            href={kushkiPaymentUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 flex items-center justify-center gap-2 rounded-xl bg-celeste-700 px-6 py-4 text-lg font-semibold text-white transition hover:bg-celeste-600"
          >
            Donar de forma segura
            <span aria-hidden="true">↗</span>
          </a>
        ) : (
          <div class="mt-6 rounded-xl border border-dashed border-celeste-200 bg-celeste-50/60 px-5 py-4 text-base text-celeste-700">
            <p class="font-semibold">Botón de donación pendiente de configurar.</p>
            <p class="mt-1 text-tinta/75">
              Falta agregar el enlace de pago de Kushki en
              <code class="rounded bg-white px-1.5 py-0.5 text-sm">PUBLIC_KUSHKI_PAYMENT_URL</code>.
            </p>
          </div>
        )
      }

      <section class="mt-10 border-t border-celeste-100 pt-8" aria-labelledby="titulo-qr">
        <div class="flex items-center gap-3">
          <span
            class="inline-flex rounded-lg bg-[#0f5132] px-3 py-1.5 text-xl font-black tracking-tight text-white"
            aria-label="DeUna"
          >
            DeUna
          </span>
          <h2 id="titulo-qr" class="text-2xl">Donar con DeUna</h2>
        </div>
        <p class="mt-2 text-base text-tinta/75">
          Abre DeUna y escanea el código QR para realizar tu aporte.
        </p>
        {
          donationQrUrl ? (
            <img
              src={donationQrUrl}
              alt="Código QR de DeUna para donar a FUNADELÁN"
              class="mt-5 h-auto w-64 rounded-xl border border-celeste-100 bg-white p-3"
              loading="lazy"
            />
          ) : (
            <div class="mt-5 grid h-64 w-64 place-items-center rounded-xl border-2 border-dashed border-celeste-200 bg-celeste-50/60 p-6 text-center text-base text-celeste-700">
              Aquí se mostrará el código QR de DeUna.
            </div>
          )
        }
      </section>
    </div>

    <aside class="rounded-2xl bg-celeste-50/70 p-7">
      <h2 class="text-xl">Transparencia</h2>
      <p class="mt-3 text-base text-tinta/80">
        Creemos en la rendición de cuentas. Consulta cómo usamos cada aporte en nuestros
        informes públicos.
      </p>
      <a
        href="/colabora/rendicion-de-cuentas"
        class="mt-5 inline-flex rounded-full border border-celeste-300 px-5 py-2.5 text-base font-semibold text-celeste-700 transition hover:bg-white"
      >
        Ver rendición de cuentas
      </a>
    </aside>
  </div>
</PageLayout>
