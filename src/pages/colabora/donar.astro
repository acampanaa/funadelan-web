---
import PageLayout from '@/layouts/PageLayout.astro';
import Icono from '@/components/Icono.astro';

const breadcrumbs = [{ label: 'Colabora', href: '/colabora' }];

// Estas variables son públicas porque se usan en enlaces e imágenes que ve el visitante.
// No incluir aquí credenciales, llaves privadas ni datos bancarios.
const kushkiPaymentUrl = import.meta.env.PUBLIC_KUSHKI_PAYMENT_URL?.trim() ?? '';
const donationQrUrl = import.meta.env.PUBLIC_DONATION_QR_URL?.trim() ?? '';
---

<PageLayout
  title="Donar"
  lead="Tu donación sostiene el acompañamiento diario a las personas mayores. Cada aporte cuenta."
  breadcrumbs={breadcrumbs}
>
  <div class="mx-auto max-w-5xl">
    <div class="mb-8 text-center">
      <p class="text-base text-tinta/75">Elige la forma que te resulte más cómoda para hacer tu aporte.</p>
    </div>

    <!-- Donaciones temporalmente deshabilitadas. Volver a activar cuando esté listo.
    <div class="grid gap-6 lg:grid-cols-2">
      <section class="flex flex-col rounded-2xl border border-celeste-100 bg-white p-6 shadow-sm sm:p-8" aria-labelledby="titulo-kushki">
        <div class="flex h-12 w-12 items-center justify-center border border-celeste-100 bg-celeste-50 text-celeste-700" aria-hidden="true">
          <Icono name="corazon" class="h-6 w-6" />
        </div>
        <h2 id="titulo-kushki" class="mt-5 text-2xl">Donación en línea</h2>
        <p class="mt-2 text-base leading-relaxed text-tinta/75">
          Aporta con tarjeta de forma segura mediante Kushki. FUNADELÁN no almacena datos de tarjetas.
        </p>
        <div class="mt-auto pt-6">
          {
            kushkiPaymentUrl ? (
              <a href={kushkiPaymentUrl} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 rounded-full bg-celeste-700 px-6 py-3.5 text-lg font-semibold text-white transition hover:bg-celeste-600">
                Donar de forma segura <span aria-hidden="true">↗</span>
              </a>
            ) : (
              <div class="rounded-xl border border-dashed border-celeste-200 bg-celeste-50/60 px-5 py-4 text-base text-celeste-700">
                <p class="font-semibold">Botón de donación pendiente de configurar.</p>
                <p class="mt-1 text-sm text-tinta/75">Falta agregar <code class="rounded bg-white px-1.5 py-0.5">PUBLIC_KUSHKI_PAYMENT_URL</code>.</p>
              </div>
            )
          }
        </div>
      </section>

      <section class="flex flex-col rounded-2xl border border-celeste-100 bg-celeste-50/50 p-6 sm:p-8" aria-labelledby="titulo-qr">
        <div class="flex items-center gap-3">
          <span class="inline-flex rounded-lg bg-[#0f5132] px-3 py-1.5 text-xl font-black tracking-tight text-white" aria-label="DeUna">DeUna</span>
          <h2 id="titulo-qr" class="text-2xl">Escanea y dona</h2>
        </div>
        <p class="mt-4 text-base leading-relaxed text-tinta/75">Abre DeUna y escanea el código QR para realizar tu aporte.</p>
        <div class="mt-5 flex flex-1 items-center justify-center">
          {
            donationQrUrl ? (
              <img src={donationQrUrl} alt="Código QR de DeUna para donar a FUNADELÁN" class="h-auto w-52 rounded-xl border border-celeste-100 bg-white p-3 shadow-sm" loading="lazy" />
            ) : (
              <div class="grid h-52 w-52 place-items-center rounded-xl border-2 border-dashed border-celeste-200 bg-white p-6 text-center text-base text-celeste-700">Aquí se mostrará el código QR de DeUna.</div>
            )
          }
        </div>
      </section>
    </div>
    -->

    <div class="rounded-2xl border border-dashed border-celeste-200 bg-celeste-50/60 px-6 py-10 text-center">
      <p class="text-lg font-semibold text-celeste-800">Las donaciones en línea no están disponibles por el momento.</p>
      <p class="mt-2 text-base text-tinta/75">Estamos trabajando para habilitarlas pronto. Mientras tanto, podés colaborar como voluntario/a.</p>
      <a href="/colabora/voluntariado" class="mt-5 inline-flex items-center justify-center rounded-full bg-celeste-700 px-6 py-3 text-base font-semibold text-white transition hover:bg-celeste-600">
        Quiero ser voluntario/a
      </a>
    </div>

    <aside class="mt-6 flex flex-col gap-5 rounded-2xl bg-celeste-50/70 p-6 sm:flex-row sm:items-center sm:justify-between sm:px-8">
      <div>
        <h2 class="text-xl">Tu aporte, con transparencia</h2>
        <p class="mt-1 text-base text-tinta/80">Consulta cómo usamos cada aporte en nuestros informes públicos.</p>
      </div>
      <a href="/colabora/rendicion-de-cuentas" class="inline-flex shrink-0 justify-center rounded-full border border-celeste-300 px-5 py-2.5 text-base font-semibold text-celeste-700 transition hover:bg-white">Ver rendición de cuentas</a>
    </aside>
  </div>
</PageLayout>
