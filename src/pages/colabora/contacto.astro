---
import PageLayout from '@/layouts/PageLayout.astro';

const breadcrumbs = [{ label: 'Colabora', href: '/colabora' }];
---

<PageLayout
  title="Contacto"
  lead="¿Tienes preguntas o quieres colaborar? Escríbenos y te responderemos pronto."
  breadcrumbs={breadcrumbs}
>
  <div class="grid gap-12 lg:grid-cols-[1.2fr_1fr]">
    <!-- Formulario (Netlify Forms) -->
    <form
      name="contacto"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      action="/colabora/contacto?enviado=1"
      class="space-y-5"
    >
      <input type="hidden" name="form-name" value="contacto" />
      <p class="hidden">
        <label>No llenar: <input name="bot-field" /></label>
      </p>

      <div>
        <label for="nombre" class="block text-base font-semibold text-celeste-800">Nombre completo</label>
        <input id="nombre" name="nombre" type="text" required
          class="mt-2 w-full rounded-xl border border-celeste-200 px-4 py-3 text-base focus:border-celeste-400" />
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="email" class="block text-base font-semibold text-celeste-800">Correo electrónico</label>
          <input id="email" name="email" type="email" required
            class="mt-2 w-full rounded-xl border border-celeste-200 px-4 py-3 text-base focus:border-celeste-400" />
        </div>
        <div>
          <label for="telefono" class="block text-base font-semibold text-celeste-800">Teléfono (opcional)</label>
          <input id="telefono" name="telefono" type="tel"
            class="mt-2 w-full rounded-xl border border-celeste-200 px-4 py-3 text-base focus:border-celeste-400" />
        </div>
      </div>

      <div>
        <label for="asunto" class="block text-base font-semibold text-celeste-800">Asunto</label>
        <input id="asunto" name="asunto" type="text"
          class="mt-2 w-full rounded-xl border border-celeste-200 px-4 py-3 text-base focus:border-celeste-400" />
      </div>

      <div>
        <label for="mensaje" class="block text-base font-semibold text-celeste-800">Mensaje</label>
        <textarea id="mensaje" name="mensaje" rows="5" required
          class="mt-2 w-full rounded-xl border border-celeste-200 px-4 py-3 text-base focus:border-celeste-400"></textarea>
      </div>

      <button type="submit"
        class="rounded-full bg-dorado-400 px-8 py-3.5 text-lg font-semibold text-celeste-900 transition hover:bg-dorado-300">
        Enviar mensaje
      </button>
    </form>

    <!-- Datos de contacto -->
    <aside class="space-y-6 rounded-2xl bg-celeste-50/70 p-7">
      <div>
        <h2 class="text-xl">Dónde estamos</h2>
        <p class="mt-2 text-base text-tinta/80">Portoviejo, Manabí, Ecuador.</p>
      </div>
      <div>
        <h2 class="text-xl">Escríbenos</h2>
        <p class="mt-2 text-base text-tinta/80">contacto@funadelan.org</p>
      </div>
      <div>
        <h2 class="text-xl">Síguenos</h2>
        <p class="mt-2 text-base text-tinta/80">Facebook · Instagram</p>
      </div>
    </aside>
  </div>
</PageLayout>
