---
import PageLayout from '@/layouts/PageLayout.astro';
import CampoTelefono from '@/components/CampoTelefono.astro';
import Obligatorio from '@/components/Obligatorio.astro';

const breadcrumbs = [{ label: 'Colabora', href: '/colabora' }];
---

<PageLayout
  title="Contacto"
  lead="¿Tienes alguna pregunta o propuesta? Escríbenos para solicitar información, proponer una alianza o comunicarte con nuestro equipo."
  breadcrumbs={breadcrumbs}
>
  <div class="grid gap-12 lg:grid-cols-[1.2fr_1fr]">
    <!-- Formulario (envía a /api/contacto) -->
    <form id="form-contacto" method="POST" action="/api/contacto" class="space-y-5">
      <p class="hidden" aria-hidden="true">
        <label>No llenar: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
      </p>

      <div>
        <label for="nombre" class="block text-base font-semibold text-celeste-800">Nombre completo <Obligatorio /></label>
        <input id="nombre" name="nombre" type="text" required
          class="mt-2 w-full rounded-xl border border-celeste-200 px-4 py-3 text-base focus:border-celeste-400" />
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="email" class="block text-base font-semibold text-celeste-800">Correo electrónico <Obligatorio /></label>
          <input id="email" name="email" type="email" required
            class="mt-2 w-full rounded-xl border border-celeste-200 px-4 py-3 text-base focus:border-celeste-400" />
        </div>
        <CampoTelefono etiqueta="Teléfono (opcional)" />
      </div>

      <div>
        <label for="asunto" class="block text-base font-semibold text-celeste-800">Asunto</label>
        <input id="asunto" name="asunto" type="text"
          class="mt-2 w-full rounded-xl border border-celeste-200 px-4 py-3 text-base focus:border-celeste-400" />
      </div>

      <div>
        <label for="mensaje" class="block text-base font-semibold text-celeste-800">Mensaje <Obligatorio /></label>
        <textarea id="mensaje" name="mensaje" rows="5" required
          class="mt-2 w-full rounded-xl border border-celeste-200 px-4 py-3 text-base focus:border-celeste-400"></textarea>
      </div>

      <button type="submit"
        class="rounded-full bg-dorado-400 px-8 py-3.5 text-lg font-semibold text-celeste-900 transition hover:bg-dorado-300 disabled:opacity-60">
        Enviar mensaje
      </button>

      <p id="contacto-mensaje" role="status" aria-live="polite" class="text-base"></p>
    </form>

    <!-- Datos de contacto -->
    <aside class="space-y-6 rounded-2xl bg-celeste-50/70 p-7">
      <div>
        <h2 class="text-xl">Dónde estamos</h2>
        <p class="mt-2 text-base text-tinta/80">Portoviejo, Manabí, Ecuador.</p>
      </div>
      <div>
        <h2 class="text-xl">Escríbenos</h2>
        <a
          href="mailto:fundacionamigosdelosangeles@gmail.com"
          class="mt-2 block text-base text-celeste-700 underline-offset-4 transition hover:underline"
        >
          fundacionamigosdelosangeles@gmail.com
        </a>
      </div>
      <div>
        <h2 class="text-xl">Síguenos</h2>
        <p class="mt-1 mb-3 text-sm text-tinta/70">
          Estamos en redes sociales. ¡Únete a nuestra comunidad!
        </p>
        <div class="flex flex-col gap-2">
          <a
            href="https://www.facebook.com/profile.php?id=100064983300077"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 rounded-xl bg-[#0e65d9] px-4 py-3 text-base font-semibold text-white transition hover:bg-[#0b52b0]"
          >
            <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0" fill="currentColor" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            Facebook
          </a>
          <a
            href="https://www.instagram.com/funadelan_ec/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 rounded-xl bg-gradient-to-r from-[#f09433] via-[#dc2743] to-[#bc1888] px-4 py-3 text-base font-semibold text-white transition hover:opacity-90"
          >
            <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0" fill="currentColor" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            Instagram — @funadelan_ec
          </a>
        </div>
      </div>
    </aside>
  </div>

  <script>
    const form = document.getElementById('form-contacto') as HTMLFormElement | null;
    const msg = document.getElementById('contacto-mensaje');
    const boton = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!msg || !boton) return;

      boton.disabled = true;
      msg.textContent = 'Enviando…';
      msg.style.color = '#a33818';

      try {
        const res = await fetch('/api/contacto', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const data = await res.json();
        if (data.ok) {
          msg.textContent = data.mensaje || '¡Mensaje enviado!';
          msg.style.color = '#15803d';
          form.reset();
        } else {
          msg.textContent = data.error || 'Ocurrió un error. Intenta de nuevo.';
          msg.style.color = '#b91c1c';
        }
      } catch {
        msg.textContent = 'No se pudo conectar. Intenta más tarde.';
        msg.style.color = '#b91c1c';
      } finally {
        boton.disabled = false;
      }
    });
  </script>
</PageLayout>
