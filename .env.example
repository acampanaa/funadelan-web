# --- Sanity ---
# Copia este archivo a .env y reemplaza los valores.
PUBLIC_SANITY_PROJECT_ID=your-project-id
PUBLIC_SANITY_DATASET=production
# Token con permiso de lectura (solo para contenido en borrador / previews).
SANITY_API_READ_TOKEN=

# --- Brevo (boletín por correo) ---
BREVO_API_KEY=
BREVO_LIST_ID=

# --- Webhook Sanity -> Netlify Function ---
SANITY_WEBHOOK_SECRET=

# --- Donaciones ---
PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
PUBLIC_PAYPAL_CLIENT_ID=
