# --- Sanity ---
# Copia este archivo a .env y reemplaza los valores.
PUBLIC_SANITY_PROJECT_ID=your-project-id
PUBLIC_SANITY_DATASET=production
# Token con permiso de lectura (solo para contenido en borrador / previews).
SANITY_API_READ_TOKEN=

# --- Brevo (boletín por correo) ---
BREVO_API_KEY=
BREVO_LIST_ID=
# Lista donde se anota a quien se ofrece como voluntario. Va aparte de la del
# boletín: se apuntaron a ayudar, no a recibir correos. Si se deja vacío, la
# solicitud llega igual por correo pero no queda registrada en ninguna lista.
BREVO_LIST_VOLUNTARIOS_ID=
# Correo y nombre del remitente (DEBE estar verificado en Brevo).
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=FUNADELÁN
# A dónde llegan los mensajes del formulario de contacto.
# Si se deja vacío, llegan al mismo BREVO_SENDER_EMAIL.
CONTACTO_EMAIL_DESTINO=

# URL pública del sitio. Se usa para el logo y los enlaces de los correos,
# que necesitan direcciones absolutas. Mientras funadelan.org no esté
# publicado, apúntalo al dominio de Netlify (https://<sitio>.netlify.app).
PUBLIC_SITE_URL=https://funadelan.org

# --- Webhook Sanity -> Netlify Function ---
# Obligatorio: sin este secreto la función rechaza los webhooks, para que
# nadie pueda disparar un envío masivo conociendo solo la URL.
SANITY_WEBHOOK_SECRET=

# --- Donaciones ---
# Enlace público generado por Kushki para recibir donaciones.
PUBLIC_KUSHKI_PAYMENT_URL=
# Ruta pública o URL HTTPS de la imagen QR (ejemplo: /qr-donacion.png).
PUBLIC_DONATION_QR_URL=
